---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "恵庭市空手クラブ",
    address: "恵庭市南島松389-3 島松体育館",
    schedule: ["金曜16:00(R4.2より)"],
  },
];
---

<BaseLayout
  title="恵庭市空手教室(島松空手)"
  description="恵庭市南島松・島松体育館を会場にした清心会空手道場・教室のご案内。キッズ・ジュニアクラス中心の空手クラブ、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/eniwa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・恵庭支部</h1>
      </div>

      <p class="detail-page__lead">
        [恵庭市空手教室・清心会恵庭支部]　島松空手/恵み野空手<br />
        恵庭空手教室は、平成25年3月にスタートしました。<br />
        会場は、島松体育館です。<br />
        キッズ・ジュニアクラスを中心としています。親子での参加、シニアクラスの参加も歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。<br />
        ※3歳時は親子参加で月額無料キャンペーン実施中
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=恵庭 体験・入会問い合わせ"
          >事務局</a
        >までお願いします。<br />
        島松体育館の他、コープ恵庭ミーティングルームで練習する場合もあります。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/eniwa/Image1.jpg"
            alt="恵庭支部の稽古風景"
            width="261"
            height="111"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/eniwa/2.jpg"
            alt="島松体育館"
            width="254"
            height="160"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">恵庭支部</h2>
      <p>
        ◆設立　平成25年(2013)3月<br />
        ◆師範代　髙嶋和也<br />
        ◆指導員　本部直轄<br />
        ◆担当師範　前川(複数名が交代で担当します)
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/島松体育館/@42.917452,141.5843139,15z/data=!4m2!3m1!1s0x0:0x800612839adc2133?sa=X&ved=2ahUKEwito5C8wK_hAhXaM94KHU4BD9wQ_BIwCnoECA8QCA"
          target="_blank"
          rel="noopener">恵庭市南島松389-3　島松体育館</a
        >
      </p>

      <p class="detail-page__note">
        月会費3,800円<br />
        ※3歳時は月額無料
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=恵庭 体験・入会問い合わせ">
          <img
            src="/assets/images/legacy/images/Image2.jpg"
            alt="体験・入会問い合わせはこちら"
            width="645"
            height="260"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/kitahiro/">← 帯広・恵庭・旭川の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
