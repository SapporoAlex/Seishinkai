---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "",
    name: "白石本部",
    address: "札幌市白石区中央1条5丁目4-36　白石福祉会館",
    schedule: ["木曜クラス", "17:30", "18:30"],
  },
];
---

<BaseLayout
  title="清心館白石空手道場 (白石本部)の空手教室"
  description="札幌市白石区本通、国道12号線沿いの清心館本通道場のご案内。キッズ・ジュニア空手教室の稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/shiroishi/shiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心館白石空手道場 (白石本部)</h1>
      </div>

    <h2 class="detail-page__heading">白石区の空手道場</h2>
      <div class="detail-page__img-text-pair--reverse">
        <div class="detail-media--med">
          <figure>
            <img
            src="/assets/images/dojo/img_shiroishi_1.jpg"
            alt="本通清心館の外観"
            width="234"
            height="144"
            loading="lazy"
            />
          </figure>
        </div>
        <p>
        本部道場は、昭和61年3月より白石区で常設道場を設置してスタート、以来35年に渡り活動しています。<br>
        旧札幌支部時代から数えると40年以上継続して空手活動を行っている札幌で老舗の空手道場です。<br>
        総本部ができる平成24年まで、本部道場として活動し現在は常設「白石道場」となっています。<br>
        令和8年8月より、会場を白石福祉会館2Fに移動して活動。<br>
        白石区内の空手道場としては最も古い道場のひとつと言えます。本部直轄道場で交代で指導します。<br>
        現在は園児から中学生を主体とするジュニアクラス中心に活動しています。<br>
        12号線と本郷通の中間に位置してます。
        </p>
      </div>

        <div class="detail-page__img-text-pair">
            <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_2.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
                  <figcaption>2026年8月より白石福祉会館2Fで木曜17:00より活動中
            </figcaption>
        </figure>

        </div>

      </div>


      <BranchTable entries={entries} />

        <p class="detail-page__note">
            ※白石福祉会館を利用する形となります。
        </p>

        <div class="dojo-list__map-embed">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2915.4130221087366!2d141.3980022!3d43.0537802!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f0b2bc48025a535%3A0xb5799aa9afba892d!2sShiroishi%20Ch%C5%AB%C5%8D%20Welfare%20Hall!5e0!3m2!1sen!2sjp!4v1785046476874!5m2!1sen!2sjp" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>


        <p class="detail-page__note">
            地下鉄白石駅・徒歩約14分 約1.1km、中央バス｢中央1-4｣下車徒歩約2分、JRバス｢中央1-3｣下車徒歩約5分<br>
            TEL.011-300-0048 平日13:00-15:00 夕方以降は稽古で電話に出れません
        </p>

    <h2 class="detail-page__heading">2005年～2026年7月までの21年間、この会場で活動</h2>
    <div class="detail-gallery">

        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_3.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_4.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
      </div>
      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
