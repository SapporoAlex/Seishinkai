---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "",
    name: "白石福祉会館",
    address: "札幌市白石区中央1条5丁目4-36",
    schedule: ["木曜クラス", "17:30", "18:30"],
  },
];
---

<BaseLayout
  title="清心館白石空手道場 (白石本部)の空手教室"
  description="札幌市白石区本通、国道12号線沿いの清心館本通道場のご案内。キッズ・ジュニア空手教室の稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/shiroishi/shiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心館白石空手道場 (白石本部)</h1>
      </div>

    <h2 class="detail-page__heading">白石区の空手道場</h2>
      <div class="detail-page__img-text-pair">
        <div class="detail-media">
          <figure>
            <img
            src="/assets/images/dojo/img_shiroishi_1.jpg"
            alt="本通清心館の外観"
            width="234"
            height="144"
            loading="lazy"
            />
          </figure>
        </div>
        <p>
        本部道場は、昭和61年3月より白石区で常設道場を設置してスタート、以来35年に渡り活動しています。<br>
        旧札幌支部時代から数えると40年以上継続して空手活動を行っている札幌で老舗の空手道場です。<br>
        総本部ができる平成24年まで、本部道場として活動し現在は常設「白石道場」となっています。<br>
        令和8年8月より、会場を白石福祉会館2Fに移動して活動。<br>
        白石区内の空手道場としては最も古い道場のひとつと言えます。本部直轄道場で交代で指導します。<br>
        現在は園児から中学生を主体とするジュニアクラス中心に活動しています。<br>
        12号線と本郷通の中間に位置してます。
        </p>
      </div>

        <div class="detail-page__img-text-pair">
            <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_2.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
        </div>
        <p>
            2026年8月より白石福祉会館2Fで木曜17:00より活動中
        </p>
      </div>


      <BranchTable entries={entries} />

        <p class="detail-page__note">
            ※白石福祉会館を利用する形となります。
        </p>
        <p class="detail-page__note">
            地下鉄白石駅・徒歩約14分 約1.1km、中央バス｢中央1-4｣下車徒歩約2分、JRバス｢中央1-3｣下車徒歩約5分<br>
            TEL.011-300-0048 平日13:00-15:00 夕方以降は稽古で電話に出れません
        </p>

    <h2 class="detail-page__heading">2005年～2026年7月までの21年間、この会場で活動</h2>
    <div class="detail-gallery">

        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_3.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_4.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
      </div>





      
      <h2 class="detail-page__heading">本通清心館空手道場</h2>
      <p>
        ◆設立　平成23年(2011)4月<br />
        ◆設立者　三村佳代子(2011-2015)<br />
        　歴代　ハシニ(2015-2020)、滝上由佳(2020-2021)<br />
        ◆指導　高嶋和也(2021-)、若林敬司(2020-)、増田宇倫(2024-)
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒003-0027+北海道札幌市白石区本通１６丁目北１２&#8722;４１+キッズ空手教室本通清心館/@43.0360142,141.4332405,19.5z/data=!4m12!1m6!3m5!1s0x5f0b2b0b17d719c7:0x9df984ff883e2c96!2z44OR44OG44Kj44K544Oq44O844OV44Os44O844Or!8m2!3d43.035898!4d141.4338263!3m4!1s0x5f0b2b0b18c518bb:0xad01d582492e34fe!8m2!3d43.036098!4d141.4332991"
          target="_blank"
          rel="noopener">札幌市白石区本通16丁目北12-41(国道12号線沿) 本通清心館</a
        ><br />
        地下鉄南郷18丁目駅2番出口 徒歩約11分(850m)<br />
        JRバス「下白石駅」下車徒歩3分、中央バス「本通16丁目」徒歩2分
      </p>
      <p class="detail-page__note">
        駐車場はありませんので近隣コインパーキングをご利用ください。ラウンド1外駐車場向かいに<a
          href="https://www.google.com/maps/place/三井のリパーク+札幌本通１６丁目北駐車場/@43.0368883,141.433396,20.75z/data=!4m12!1m6!3m5!1s0x5f0b2b0b17d719c7:0x9df984ff883e2c96!2z44OR44OG44Kj44K544Oq44O844OV44Os44O844Or!8m2!3d43.0462046!4d141.3794742!3m4!1s0x5f0b2b325dd7151b:0x67984f5e45181e18!8m2!3d43.0370477!4d141.4334782"
          target="_blank"
          rel="noopener">三井のリパーク</a
        >があります(本通清心館より140m、徒歩2分)。
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=本通体験申込">
          <img
            src="/assets/images/legacy/dojo/hondori/img1E.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
