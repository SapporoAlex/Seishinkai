---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    no: 1,
    marker: "★",
    name: "総本部道場",
    sub: "清心館大久保道場",
    address: "白石区栄通2丁目1-27(東北通沿)　総本部・清心館",
    schedule: [
      "昼クラス/月･水14:30",
      "月曜クラス18:30/型特設19:30",
      "水曜クラス18:30/一般19:30",
      "木曜園児低学年15:00",
      "土曜クラス①13:00(夏時間)　13:30(冬時間)　②15:30",
      "一般19:00",
      "不登校専門クラス 火曜",
      "女性クラス/金18:30",
    ],
    link: "/dojo/hq/",
  },
  {
    marker: "☆",
    name: "清心会居合部",
    address: "白石区栄通2丁目1-27(東北通沿)　総本部・清心館",
    schedule: ["日曜14:00(居合)", "短棒クラス15:15(日曜隔週)"],
    link: "/dojo/iai/",
  },
    {
    no: 2,
    marker: "★",
    name: "白石支部（旧白石清心館道場）",
    address: "白石区中央1条5丁目4-36　白石福祉会館2F(※R8.8より会場は上記へ)",
    schedule: [
      "木曜クラス ①17:30 ②18:30",
    ],
    link: "/dojo/shiroishi/shiroishi/",
  },
  {
    no: 3,
    marker: "★",
    name: "清心館本通道場",
    address: "白石区本通16丁目北(国道12号線沿)　本通清心館",
    schedule: ["水曜クラス16:30", "金曜クラス19:00", "日曜特設クラス(新規受付中)"],
    link: "/dojo/hondori/",
  },
  {
    no: 4,
    marker: "★",
    name: "菊水元町支部",
    address: "白石区菊水元町7条2丁目 菊水元町南町内会館",
    schedule: ["火曜18:30(冬時間18:50-)"],
    link: "/dojo/kikusui2/",
  },
  {
    no: 5,
    marker: "★",
    name: "平和通支部",
    address: "白石区平和通3丁目北 スーパーアークス白石店2F",
    schedule: ["木曜16:00"],
    link: "/dojo/heiwa/",
  },
  {
    no: 6,
    marker: "★",
    name: "菊水支部",
    address: "白石区菊水3条5丁目 アークス菊水店2F",
    schedule: ["水曜クラス17:45", "木曜クラス18:45", "土曜クラス13:00"],
    link: "/dojo/kikusui/",
  },
  {
    no: 7,
    marker: "★",
    name: "北郷支部",
    address: "白石区北郷3条7丁目 北白石地区センター",
    schedule: ["火曜クラス18:30", "金曜クラス15:30"],
    link: "/dojo/kitashiroishi/",
  },
  {
    no: 8,
    marker: "★",
    name: "川下支部",
    address: "白石区川下3条4丁目1-1 コープさっぽろ川下店2F",
    pdfText: "➜ 入り口案内（PDF）",
    pdf: "/assets/pdf/kawashimo.pdf",
    schedule: ["土曜 10:30"],
    link: "/dojo/kawashimo/",
  },
  {
    no: 9,
    marker: "●",
    name: "ルーシー南郷支部水曜クラス",
    address: "白石区栄通18丁目 コープさっぽろ(ルーシー文化教室)",
    schedule: ["水曜16:00"],
    link: "/dojo/nango/",
  },
];
---

<BaseLayout
  title="白石区の空手教室"
  description="札幌市白石区の清心会空手道場・教室一覧。総本部道場をはじめ白石区内各支部の稽古日をご案内します。"
  lang="ja"
  path="/dojo/shiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO LIST</span>
        <h1 class="section-title">札幌白石区空手道場・教室の一覧</h1>
      </div>
      <p class="detail-page__contact">
        お問い合わせは　TEL.011-300-0048(平日13:00-16:00)
      </p>

      <BranchTable entries={entries} />

      <ul class="detail-legend">
        <li>
          <span class="detail-legend__marker">★</span>本部直轄教室=お問い合わせは本部事務局へ
        </li>
        <li>
          <span class="detail-legend__marker">●</span>講師派遣教室=お問い合わせは主催文化教室・スポーツクラブへ
        </li>
        <li>
          <span class="detail-legend__marker">□</span>自主管理道場=事務局又は直接、管理担当者へ
        </li>
      </ul>

      <section class="partner-section">
        <h2 class="detail-page__heading">YouTubeで見る清心会空手</h2>

        <div class="youtube-grid">
          <a
            class="youtube-card"
            href="https://www.youtube.com/watch?v=yTxLbmtNGG4"
            target="_blank"
            rel="noopener"
          >
            <span class="youtube-card__thumb">
              <img
                src="/assets/images/legacy/news/Image1.jpg"
                alt="清心会空手 紹介動画(YouTube)"
                loading="lazy"
              />
            </span>
            <span>紹介動画</span>
          </a>
        </div>
      </section>

      <p class="detail-page__back">
        <a href="/dojo/">← 空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
