---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "#",
    name: "清心会真駒内支部",
    sub: "真駒内空手倶楽部",
    address: "札幌市南区真駒内幸町2丁目2-1　南区民センター集会室等",
    schedule: ["月曜18:30-19:30"],
  },
];
---

<BaseLayout
  title="南区真駒内支部の空手教室"
  description="札幌市南区真駒内・南区民センターの清心会空手教室のご案内。キッズ・ジュニア空手中心、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/makomanai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・真駒内支部</h1>
      </div>
      <h2 class="detail-page__heading">南区真駒内空手教室・清心会真駒内支部</h2>
      <p class="detail-page__lead">
      真駒内空手教室は平成19年に真駒内五輪児童会館でスタートしましたが、
      平成29年に所属員が減り藻岩、常盤支部と統合しましたが、令和元年9月
      より再開しました。
      地域の小学校の統廃合に伴い、児童会館の閉鎖となり令和8年8月より南区
      民センター集会室で稽古を行っています。
      キッズ空手、ジュニア空手として園児から中学生を中心としていきたいと
      思います。<span class="u-color-red u-bold">体験者募集中です!</span>
      </p>
      <p class="detail-page__lead">
      また親子での参加が他教室支部より多いかと思います。
      体育会系部活の延長線上のような道場が多い中、健康・体育の空手として
      サークル感覚で楽しく練習して学ぶことを目指しています。
      ※統廃合で新しい児童会館等が含めて現在の区民センターから良い場所が
      あれば移動することもあります。
      </p>

        <div class="detail-page__highlight-box">
          <p class="detail-page__highlight-text">負けない心、くじけない心をつくる 清心会空手</p>
        </div>

      <BranchTable entries={entries} />

      <BranchInfoCard
        name="清心会真駒内支部/真駒内空手倶楽部"
        facts={[
          { label: "設立", value: "平成19年(2007)4月(〜2017)" },
          { label: "設立者", value: "室木拓士" },
          { label: "再開", value: "令和元年(2019)9月" },
          { label: "担当", value: "沖村" },
        ]}
        image={{
          src: "/assets/images/dojo/img_makomanai_01.jpg",
          alt: "札幌市南区真駒内幸町2丁目2-1　南区民センター集会室等",
          width: 299,
          height: 154,
        }}
        instructors={[
          { src: "/assets/images/instructors/okimura.jpg", alt: "指導 沖村", name: "沖村" },
        ]}
        address="札幌市南区真駒内幸町2丁目2-1　南区民センター集会室等"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/makomanai/acs1.jpg"
            alt="真駒内支部の稽古風景"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
      ※不定期で一般部員有段者が参加します
      </p>

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=真駒内体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=真駒内体験申込">
          <img
            src="/assets/images/legacy/dojo/makomanai/img9.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/minami-kiyota/">← 清田区・南区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
