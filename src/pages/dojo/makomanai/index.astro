---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "清心会真駒内支部",
    sub: "真駒内空手倶楽部",
    address: "札幌市南区真駒内泉町3丁目13-1(真駒内学園敷地内)まこまないごりん児童会館",
    schedule: ["月曜18:30-19:30"],
  },
];
---

<BaseLayout
  title="南区真駒内支部の空手教室"
  description="札幌市南区真駒内・南区民センターの清心会空手教室のご案内。キッズ・ジュニア空手中心、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/makomanai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・真駒内支部</h1>
      </div>

      <h2 class="detail-page__heading">南区真駒内空手教室・清心会真駒内支部</h2>

      <p class="detail-page__lead">
        真駒内空手教室は平成19年に真駒内五輪児童会館でスタートしましたが、平成29年に所属員が減り藻岩、常盤支部と統合しましたが、令和元年9月より再開しました。<br>
        地域の小学校の統廃合に伴い、現在の児童会館の閉鎖となり令和8年8月より南区民センター集会室で稽古を行っていますが令和8年10月より統廃合で新しくできた真駒内学園敷地内の「まこまないごりん児童会館」で活動中です。<br>
        キッズ空手、ジュニア空手として園児から中学生を中心としていきたいと思います。<span class="u-color-red u-bold">体験者募集中です!</span><br>
        また親子での参加が他教室支部より多いかと思います。体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。<br>
      </p>

        <div class="detail-page__highlight-box">
          <p class="detail-page__highlight-text">負けない心、くじけない心をつくる 清心会空手</p>
        </div>

      <BranchTable entries={entries} />

      {/* instructors={[
        { src: "/assets/images/instructors/okimura.jpg", alt: "指導 沖村", name: "沖村" },
      ]} */}
      <BranchInfoCard
        name="清心会真駒内支部/真駒内空手倶楽部"
        facts={[
          { label: "設立", value: "平成19年(2007)4月(〜2017)" },
          { label: "設立者", value: "室木拓士" },
          { label: "再開", value: "令和元年(2019)9月" },
          { label: "担当", value: "本部直轄" },
        ]}
        image={{
          src: "/assets/images/dojo/img_makomanai_bld.jpg",
          alt: "札幌市南区真駒内泉町3丁目13-1(真駒内学園敷地内)まこまないごりん児童会館",
          width: 299,
          height: 154,
        }}
        address="札幌市南区真駒内泉町3丁目13-1(真駒内学園敷地内)まこまないごりん児童会館",
        mapHref="https://www.google.com/maps/place/3-ch%C5%8Dme-13-1+Makomanaiizumimachi,+Minami+Ward,+Sapporo,+Hokkaido+005-0015/@42.984901,141.3559624,17z/data=!3m1!4b1!4m6!3m5!1s0x5f0ad53e60343645:0x87c2ba4e3f32a4f3!8m2!3d42.984901!4d141.3559624!16s%2Fg%2F11cpcgxp99?entry=ttu&g_ep=EgoyMDI2MDkyMC4wIKXMDSoASAFQAw%3D%3D"
        mapQuery="3-chōme-13-1 Makomanaiizumimachi, Minami Ward, Sapporo, Hokkaido 005-0015"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_01.jpg"
            alt="真駒内支部の稽古風景"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_02.jpg"
            alt="真駒内支部の稽古風景"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_03.jpg"
            alt="真駒内支部の稽古風景"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_04.jpg"
            alt="真駒内支部の稽古風景"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
      ※不定期で一般部員有段者が参加します
      </p>

      <p class="detail-page__back">
        <a href="/dojo/minami-kiyota/">← 清田区・南区空手道場・教室の一覧へ戻る</a>
      </p>

      <DojoContactSection
        dojoName="真駒内支部"
        subject="真駒内体験申込"
      />
    </div>
  </section>
</BaseLayout>
