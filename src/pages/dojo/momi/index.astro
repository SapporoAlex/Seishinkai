---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "もみじ台支部",
    address: "厚別区もみじ台北7丁目　もみじ台管理センター",
    schedule: ["土曜","①10:00-10:55",
         "②11:00-11:30"],
  },
];
---

<BaseLayout
  title="もみじ台支部の空手教室"
  description="札幌市厚別区もみじ台の清心会空手道場・教室のご案内。土曜クラスの稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/momi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・もみじ台支部</h1>
      </div>

      <p class="detail-page__lead">
        [厚別区もみじ台空手教室・清心会もみじ台支部]<br />
        もみじ台空手教室は、平成22年4月よりもみじ台管理センターで活動を始めました。<br />
        設立以来、キッズ空手、ジュニア空手として開始し、園児から大人(親子)まで幅広く参加しています。<br />
        特に親子での参加を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※練習日は土曜10:00-10:55、11:00-11:30。<br />
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=もみじ台体験・入会問い合わせ"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_momi_01.jpg"
            alt="もみじ台支部の稽古風景"
            width="287"
            height="123"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/momi/2.jpg"
            alt="もみじ台管理センター"
            width="330"
            height="213"
            loading="lazy"
          />
          <figcaption>もみじ台ショッピングセンターに隣接</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/maekawa.jpg"
            alt=""
            width="106"
            height="106"
            loading="lazy"
          />
          <figcaption>前川信孝（不定期に参加）</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">もみじ台支部</h2>
      <p>
        ◆設立　平成22年(2010) 4月<br />
        ◆担当　前川、他一般部有段者会員
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/もみじ台管理センター/@43.031883,141.491963,15z/data=!4m5!3m4!1s0x0:0x7df1cd1f8ac0d953!8m2!3d43.031883!4d141.491963"
          target="_blank"
          rel="noopener">厚別区もみじ台7丁目1-1　もみじ台管理センター集会室</a
        >
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=もみじ台体験・入会問い合わせ">
          <img
            src="/assets/images/legacy/dojo/momi/imgA.jpg"
            alt="体験申込はこちら"
            width="645"
            height="271"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/atsubetsu/">← 厚別区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
