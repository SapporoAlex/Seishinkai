---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "★",
    name: "太平空手クラブ(太平里支部)",
    address: "北区篠路3条8丁目 篠路コミニティセンター2F",
    schedule: ["土曜13:30"],
  },
];
---

<BaseLayout
  title="札幌市北区太平里支部の空手教室"
  description="札幌市北区太平里の清心会空手道場・教室のご案内。もとは太平児童会館で発足し、現在は篠路コミニティセンターを会場に土曜稽古を行うキッズ・ジュニア空手クラブです。"
  lang="ja"
  path="/dojo/taihei/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・太平里支部</h1>
      </div>

      <p class="detail-page__lead">
        [北区太平空手教室・清心会太平支部]<br />
        太平空手教室は、平成22年4月に太平児童会館で活動を開始しました。<br />
        現在はコロナ等の関係もあり、篠路コミニティセンターを会場としています。<br />
        キッズ空手、ジュニア空手、親子空手中心の空手クラブです。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=太平里支部 体験・入会問い合わせ"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/taihei/Image1.jpg"
            alt="太平里支部の稽古風景"
            width="423"
            height="242"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/photo/Image2.jpg"
            alt="清心会空手 稽古の様子"
            width="570"
            height="340"
            loading="lazy"
          />
        </figure>
      </div>

      <BranchInfoCard
        name="清心会太平支部"
        facts={[
          { label: "設立", value: "平成22年(2010)4月" },
          { label: "設立者", value: "室木拓士" },
        ]}
        instructors={[
          { src: "/assets/images/instructors/muroki.jpg", alt: "指導担当 室木", name: "室木" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/shinoro/2.jpg",
          alt: "篠路コミニティセンター",
          width: 282,
          height: 245,
        }}
        address="札幌市北区篠路3条8丁目11-1　篠路コミニティセンター2F"
        mapHref="https://www.google.com/maps/place/札幌市篠路コミュニティセンター/@43.1431773,141.367712,15z/data=!4m2!3m1!1s0x0:0x4aaefe8a200690fe?sa=X&ved=2ahUKEwjf6on517HhAhWCAYgKHV-_BqEQ_BIwCnoECAcQCA"
        mapQuery="43.1431773,141.367712"
        viewOnMapLabel="Google Mapsで見る"
      />

      <p class="detail-page__note">
        ※発足当初の会場：<a
          href="https://www.google.com/maps/place/札幌市役所+子ども未来局子ども育成部太平児童会館/@43.132231,141.359608,15z/data=!4m2!3m1!1s0x0:0xad788ca95c088659?sa=X&ved=2ahUKEwifkp6E3rHhAhUSPnAKHbKXAtIQ_BIwCnoECAoQCA"
          target="_blank"
          rel="noopener">札幌市北区太平8条7丁目2-1　太平児童会館</a
        >
      </p>

      <p class="detail-page__back">
        <a href="/dojo/kita/">← 札幌市北区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
