---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "#",
    name: "岩見沢空手クラブ",
    address: "岩見沢市4条西1丁目 岩見沢生涯学習センター",
    schedule: ["月曜18:30"],
  },
];
---

<BaseLayout
  title="岩見沢市空手教室"
  description="岩見沢市の清心会空手道場・教室のご案内。岩見沢生涯学習センターを会場にしたジュニアクラス中心の空手クラブ、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/iwamizawa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・岩見沢支部</h1>
      </div>

      <p class="detail-page__lead">
        [岩見沢空手教室・清心会岩見沢支部]<br />
        岩見沢空手教室は、平成17年3月に、岩見沢市役所を定年退職した石森師範より設立されました。<br />
        ジュニアクラス中心の空手クラブです。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=岩見沢体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/images/ishimori.jpg"
            alt="設立者 石森忠之"
            width="142"
            height="142"
            loading="lazy"
          />
        </figure>
        <figure>
          <a
            href="https://www.youtube.com/watch?v=JVp0_WWPIQs"
            target="_blank"
            rel="noopener"
          >
            <img
              src="/assets/images/legacy/dojo/iwamizawa/Image1.jpg"
              alt="岩見沢支部の稽古風景"
              width="256"
              height="140"
              loading="lazy"
            />
          </a>
        </figure>
      </div>

      <h2 class="detail-page__heading">岩見沢支部/岩見沢空手倶楽部</h2>
      <p>
        ◆設立　平成17年(2005)3月<br />
        ◆設立者　石森忠之
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/岩見沢市+生涯学習センターいわなび/@43.2028905,141.7662754,15z/data=!4m5!3m4!1s0x0:0x43bfeebd5643c2e9!8m2!3d43.2028905!4d141.7662754"
          target="_blank"
          rel="noopener">岩見沢市4条西1丁目 岩見沢生涯学習センター</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/岩見沢市+生涯学習センターいわなび/@43.2028905,141.7662754,15z/data=!4m5!3m4!1s0x0:0x43bfeebd5643c2e9!8m2!3d43.2028905!4d141.7662754"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/iwamizawa/2.jpg"
            alt="岩見沢生涯学習センター"
            width="270"
            height="190"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=岩見沢体験申込">
          <img
            src="/assets/images/legacy/dojo/iwamizawa/img2.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/ebetsu/">← 江別・岩見沢・石狩の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
