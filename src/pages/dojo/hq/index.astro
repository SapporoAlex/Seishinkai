---
import BaseLayout from "@layouts/BaseLayout.astro";
import ClassScheduleCard from "@components/ClassScheduleCard.astro";

const classes = [
  {
    title: "ジュニアクラス／親子クラス",
    schedule: [
      "月曜クラス 18:30-19:30",
      "水曜クラス 18:30-19:30",
      "月曜19:30 特設・型",
    ],
    instructors: [
      {
        name: "大久保 翼",
        position: "首席師範",
        image: "/assets/images/instructors/tsubasa.jpg",
      },
    ],
  },
  {
    title: "土曜健康クラス",
    schedule: ["土曜 13:30-14:30"],
    instructors: [
      {
        name: "室木 拓士",
        position: "師範",
        image: "/assets/images/instructors/muroki.jpg",
      },
    ],
  },
  {
    title: "土曜クラス",
    schedule: ["土曜 15:30-16:30"],
    instructors: [
      {
        name: "島",
        position: "師範代",
        image: "/assets/images/instructors/shima.jpg",
      },
    ],
  },
  {
    title: "園児・低学年クラス NEW！／白帯クラス(少人数制)",
    schedule: ["木曜ちびっ子クラス 15:00-15:45"],
    instructors: [
      {
        name: "沖村 さおり",
        position: "師範補",
        image: "/assets/images/instructors/okimura.jpg",
      },
      {
        name: "瑠唯",
        position: "内弟子",
        image: "/assets/images/instructors/rui.jpg",
      },
    ],
  },
  {
    title: "シニアクラス／主婦クラス(昼の部・自主練)",
    schedule: ["月曜・水曜 14:30-15:30"],
    instructors: [
      {
        name: "木村 孝雄",
        position: "師範補",
        image: "/assets/images/instructors/kimura.jpg",
      },
    ],
  },
  {
    title: "不登校学生専門クラス(個別体験実施中)",
    schedule: ["火曜 15:00／17:00", "木曜 15:00〜"],
    instructors: [
      {
        name: "前川 信孝",
        position: "師範",
        image: "/assets/images/instructors/maekawa.jpg",
      },
    ],
  },
  {
    title: "女性クラス",
    schedule: ["金曜 18:30-19:30"],
    instructors: [
      {
        name: "山崎 麻美",
        position: "師範代",
        image: "/assets/images/instructors/asami.jpg",
      },
    ],
  },
  {
    title: "一般部(学生・社会人)",
    schedule: ["水曜 19:30-21:00", "土曜 19:00-21:00"],
    instructors: [
      {
        name: "大久保 翼",
        position: "首席師範",
        image: "/assets/images/instructors/tsubasa.jpg",
      },
      {
        name: "大久保 勝美",
        position: "宗家",
        image: "/assets/images/instructors/masami.jpg",
      },
    ],
  },
  {
    title: "居合部",
    schedule: ["日曜 14:00-15:00"],
    instructors: [
      {
        name: "室木 拓士",
        position: "師範",
        image: "/assets/images/instructors/muroki.jpg",
      },
    ],
  },
];
---

<BaseLayout
  title="総本部道場について"
  description="清心会総本部・清心館大久保道場のご案内。白石区栄通の総建坪200坪、北海道最大規模の常設道場の沿革とアクセスをご紹介します。"
  lang="ja"
  path="/dojo/hq/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">HEADQUARTERS</span>
        <h1 class="section-title">総本部・清心館大久保道場</h1>
      </div>

      <p class="detail-page__lead">
        [白石区と豊平区の境である東北通に面している空手道場です]<br />
        本部道場は、昭和61年3月より白石区で常設道場を設置してスタートしています。<br />
        旧札幌支部時代から半世紀に渡り継続して空手活動を行っている札幌でも老舗の空手道場です。<br />
        現在地へは平成24年に移転、駐車場を備え、道場も本館、別館合わせて建坪200坪を有する北海道では最大規模の常設道場となります。<br />
        下は3才から上は84才まで楽しい汗を流しています。本部道場は中学生以下のジュニアクラス(月・水)、高校生以上の一般部(水・土)、園児･低学年向けキッズクラス(木)、女性クラス(金)、ジュニア＆親子クラス(土)、主婦･シニア向けの昼の部(月・水)、居合部(日)などがあります。<br />
        ※不登校生徒のための特別クラスも新設しました。
      </p>
      <h2 class="detail-page__heading">クラス案内</h2>
      <div class="class-schedule-grid">
        {
          classes.map((c) => (
            <ClassScheduleCard
              title={c.title}
              schedule={c.schedule}
              instructors={c.instructors}
            />
          ))
        }
      </div>
      <p class="detail-page__note">
        ●特設(短棒・双節棍) 日曜夕方(<a
          href="http://karate15.dokkin.com/"
          target="_blank"
          rel="noopener">不定期</a
        >・事前申込必要です)
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/Image1.jpg"
            alt="総本部道場でのジュニアクラスの稽古"
            loading="lazy"
          />
          <figcaption>ジュニアクラスの稽古風景</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/Image2.jpg"
            alt="総本部道場での親子クラスの稽古"
            loading="lazy"
          />
          <figcaption>親子クラスの稽古風景</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/img6.jpg"
            alt="総本部道場での一般部の稽古"
            loading="lazy"
          />
          <figcaption>一般部の稽古風景</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/Image3.jpg"
            alt="個別体験でのクラス風景"
            loading="lazy"
          />
          <figcaption>個別体験実施中</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/img5.jpg"
            alt="総本部道場での一般部の稽古"
            loading="lazy"
          />
          <figcaption>一般部の稽古風景</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/4.jpg"
            alt="シニアクラス・主婦クラスの稽古"
            loading="lazy"
          />
          <figcaption>シニアクラス・主婦クラスの稽古</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">沿革</h2>
      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/Image7.jpg"
            alt="昭和61年、最初の常設本部道場"
            loading="lazy"
          />
          <figcaption>
            ▲昭和61年、最初の常設本部道場16坪<br />白石区中央1-5
          </figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/MVC-466X.jpg"
            alt="平成14年、本部を移転した道場"
            loading="lazy"
          />
          <figcaption>▲平成14年、本部を移転-30坪<br />白石区東札幌6-5</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hq/DSC_0005.jpg"
            alt="平成17年、本部を移転した道場（現・清心館白石道場）"
            loading="lazy"
          />
          <figcaption>
            ▲平成17年、本部を移転-36坪<br />白石区中央1-4
          </figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/about/honbu.jpg"
            alt="総本部道場全景"
            loading="lazy"
          />
          <figcaption>▲平成24年、総本部を設置-200坪</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">アクセス</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒003-0021+北海道札幌市白石区栄通２丁目１−２７/@43.0409785,141.3938016,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bb4690b9e5f:0x622b301003410409!8m2!3d43.0409785!4d141.3959903"
          target="_blank"
          rel="noopener"
          >札幌市白石区栄通2丁目1-27 (東北通沿)</a
        ><br />
        専用駐車場完備　本館100畳、別館60畳<br />
        地下鉄白石駅・徒歩約9分(750m)、地下鉄月寒中央駅･徒歩約18分(1.4km)<br />
        中央バス「栄通1丁目」下車・徒歩約4分
      </p>
      <p class="detail-page__note">
        駐車場は本部道場裏手の別館裏(一番奥)にあります。冬期間は雪の関係で詰めての駐車となります。<br />
        <a href="/assets/pdf/p.pdf" target="_blank">冬期間の駐車の仕方(PDF)</a
        >　<a href="/assets/pdf/p4-11.pdf" target="_blank"
          >4〜11月の駐車の仕方(PDF)</a
        >
      </p>

      <p class="detail-page__back">
        <a href="/dojo/">← 空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
