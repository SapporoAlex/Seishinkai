---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "居合部",
    address: "清心館総本部",
    schedule: ["日曜 14:00〜15:00", "※秋冬春時間、夏季は夕方開始の場合あり"],
  },
];

const videos = [
  {
    href: "https://www.youtube.com/playlist?list=PLyugCVja4s7Kz8vG3OA4GyMEpSKcsDzQV",
    image: "/assets/images/legacy/dojo/iai/img6.jpg",
    caption: "演武動画",
  },
  {
    href: "https://www.youtube.com/playlist?list=PLyugCVja4s7Kz8vG3OA4GyMEpSKcsDzQV",
    image: "/assets/images/legacy/dojo/iai/img4.jpg",
    caption: "清心会居合部・初期メンバー",
  },
  {
    href: "https://www.youtube.com/channel/UClIx3Srenlu1ddf5coow83A",
    image: "/assets/images/legacy/dojo/iai/img3.jpg",
    caption: "居合部長 室木拓士のチャンネル",
  },
];
---

<BaseLayout
  title="居合部"
  description="札幌の居合・抜刀術教室、清心会居合部のご案内。清心館総本部で日曜に活動、中学生からシニアまでメンバー募集中です。"
  lang="ja"
  path="/dojo/iai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">IAIDO</span>
        <h1 class="section-title">清心会・居合部</h1>
      </div>

      <p class="detail-page__lead">
        [清心会居合部]<br />
        清心会居合部は、平成17年より前川師範、室木師範、故三村佳代子師範を中心に白石清心館道場でスタート。<br />
        現在は、清心館総本部で行っています。メンバーの半分は女性です。<br />
        メンバーを募集中です。<br />
        特にシニア60才以上の方を歓迎します!!<br />
        現在、<strong>中学生から上は84才まで</strong>活動しています
      </p>

      <h2 class="detail-page__heading">生涯の趣味として</h2>
      <p>
        <a href="http://karate15.dokkin.com/" target="_blank" rel="noopener"
          >日曜 14:00より</a
        ><br />
        ※秋冬春時間<br />
        夏猛暑の際は夕方開始の場合もあります<br />
        交通状況により開館時間が遅れる場合がありますので、その場合はお待ち下さい。<br />
        体験授業(1,000円)となります。単発の個別セミナーも行っています(受講料:5,000〜10,000円)。
      </p>

      <BranchTable entries={entries} />

      <BranchInfoCard
        name="清心会居合部"
        facts={[
          { label: "設立", value: "平成17年(2005)7月" },
          { label: "設立者", value: "前川信孝(初代部長)" },
          { label: "担当", value: "室木拓士(二代目部長)" },
          {
            label: "会費",
            value: [
              "入会金 7,000円",
              "年会費 5,800円",
              "基本会費 6,000円/月",
              "※空手部員は3,000円/月",
            ],
          },
        ]}
        image={{
          src: "/assets/images/dojo/img_iai_01.png",
          alt: "HQ道場",
          width: 263,
          height: 263,
        }}
        address="札幌市白石区栄通2丁目1-27 (東北通沿) 清心館総本部"
        addressNote="地下鉄白石駅・徒歩約10分 約800m"
        mapHref="https://www.google.com/maps/place/〒003-0021+北海道札幌市白石区栄通２丁目１−２７/@43.0409785,141.3938016,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bb4690b9e5f:0x622b301003410409!8m2!3d43.0409785!4d141.3959903"
        mapQuery="43.0409785,141.3938016"
        viewOnMapLabel="Google Mapsで見る"
        instructors={[
          { src: "/assets/images/instructors/muroki.jpg", alt: "指導 室木", name: "室木" },
        ]}
          
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/iai/img2.jpg"
            alt="居合の稽古風景"
            width="322"
            height="171"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/iai/img7.jpg"
            alt="清心会居合部の稽古の様子"
            width="626"
            height="218"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        体験の際にお問合せ下さい<br />
        ※昇級に伴い段階的に減額されます<br />
        ※その他、袴、居合衣、居合帯、居合刀、木刀、ソフト刀などが必要となります。
      </p>

      <section class="partner-section">
        <h2 class="detail-page__heading">YouTubeで見る清心会居合部</h2>

        <div class="youtube-grid">
          {
            videos.map((video) => (
              <a
                class="youtube-card"
                href={video.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="youtube-card__thumb">
                  <img src={video.image} alt={`${video.caption}(YouTube)`} loading="lazy" />
                </span>
                <span>{video.caption}</span>
              </a>
            ))
          }
        </div>
      </section>

      <p class="detail-page__back">
        <a href="/dojo/">← 空手道場・教室の一覧へ戻る</a>
      </p>

      <DojoContactSection
        dojoName="居合部"
        subject="居合部体験申込"
        directEmail="muroki-taku@seishinryu.info"
        directEmailLabel="居合部直通メール"
      />
    </div>
  </section>
</BaseLayout>
