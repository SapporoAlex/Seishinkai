---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "伏見支部",
    address: "中央区南14条西18丁目　伏見会館",
    schedule: ["土曜13:00-14:00"],
  },
];
---

<BaseLayout
  title="中央区伏見空手教室(平和通支部)"
  description="札幌市中央区・伏見会館の清心会空手道場・伏見支部(平和通支部)のご案内。ジュニア空手と親子空手中心の教室、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/cyuo-m/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・伏見支部</h1>
      </div>

      <p class="detail-page__lead">
        [中央区伏見空手教室・清心会伏見支部]<br />
        伏見空手教室は、支援企業の協力で支援会社の会議室スペースをお借りして平成24年4月にスタートしました。<br />
        セキュリティの関係もあり翌年、現在地の伏見会館に会場を移転して活動しています。<br />
        設立以来、ジュニア空手と親子空手としてを中心としています。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=伏見体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/cyuo-m/Image1.jpg"
            alt="伏見支部の稽古風景"
            width="292"
            height="182"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/tuba.jpg"
            alt="担当 大久保翼"
            width="128"
            height="125"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">平和通支部</h2>
      <p>
        ◆設立　平成24年(2012)4月<br />
        ◆担当者　大久保 翼<br />
        ◆私も不定期で指導に行きます　若林ゆうこ
      </p>

      <div class="detail-media">
        <img
          src="/assets/images/legacy/images/yuko1.jpg"
          alt="若林ゆうこ"
          width="136"
          height="136"
          loading="lazy"
        />
      </div>

      <h2 class="detail-page__heading">会場　伏見会館</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/伏見会館/@43.0410241,141.3303314,17z/data=!4m5!3m4!1s0x0:0x98b47c6f2cd17d85!8m2!3d43.0402439!4d141.3289367"
          target="_blank"
          rel="noopener">札幌市中央区南14条西18丁目6-10　伏見会館</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/伏見会館/@43.0410241,141.3303314,17z/data=!4m5!3m4!1s0x0:0x98b47c6f2cd17d85!8m2!3d43.0402439!4d141.3289367"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/cyuo-m/2.jpg"
            alt="伏見会館"
            width="293"
            height="200"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=伏見体験申込">
          <img
            src="/assets/images/legacy/dojo/cyuo-m/imgC.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/cyuo/">← 中央区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
