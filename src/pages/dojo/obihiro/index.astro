---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "□",
    name: "帯広市空手クラブ",
    address: "帯広市西2条南24丁目　鉄南地区",
    schedule: ["土曜18:45-20:00"],
  },
];
---

<BaseLayout
  title="帯広市空手教室"
  description="帯広市西2条南24丁目・鉄南地区コミュニティセンターを会場にした清心会空手道場・教室のご案内。キッズ・ジュニアクラス中心の空手クラブ、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/obihiro/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・帯広支部</h1>
      </div>

      <p class="detail-page__lead">
        [帯広市空手教室・清心会帯広支部]<br />
        帯広空手教室は、平成29年4月より本格的スタートしました。<br />
        会場は、鉄南地区コミュニティセンターです。<br />
        キッズ・ジュニアクラスを中心としています。親子での参加、シニアクラスの参加も歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />


      <h2 class="detail-page__heading">帯広支部 お問い合わせ</h2>
        <p class="detail-page__note">
        090-6692-6573　工藤まで（日中は働いていますので17:00以降に御連絡下さい）<br />
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=白石中央福祉会館 体験・入会問い合わせ"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/images/kudo.jpg"
            alt="担当 工藤"
            width="328"
            height="328"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/obihiro/Image1.jpg"
            alt="帯広支部の稽古風景"
            width="352"
            height="159"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/obihiro/2.jpg"
            alt="鉄南地区コミュニティセンター"
            width="180"
            height="135"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">帯広支部</h2>
      <p>
        ◆設立　平成29年(2017)4月<br />
        ◆設立者　工藤哲弘
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/d/viewer?hl=ja&ll=42.906342976232445%2C143.20808862938247&z=16&mid=1mNwLkO77ohCM0yk0rd14mWCBM33D_ais"
          target="_blank"
          rel="noopener">帯広市西2条南24丁目　鉄南地区コミュニティセンター</a
        >
      </p>

      <div class="detail-media">
        <img
          src="/assets/images/legacy/images/Image1.jpg"
          alt="鉄南地区コミュニティセンターでの稽古風景"
          width="649"
          height="196"
          loading="lazy"
        />
      </div>

      <p class="detail-page__back">
        <a href="/dojo/kitahiro/">← 帯広・恵庭・旭川の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
