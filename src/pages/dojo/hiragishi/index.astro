---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "美園支部",
    sub: "(旧:平岸支部)",
    address: "豊平区美園6条7丁目コープ美園サークル室",
    schedule: ["日曜13:30"],
    link: "/dojo/misono/",
  },
];
---

<BaseLayout
  title="豊平区平岸支部(現・美園支部)の空手教室"
  description="札幌市豊平区の旧・平岸空手教室のご案内。令和3年に美園支部へ改称・移転しました。現在の教室情報は美園支部のページをご覧ください。"
  lang="ja"
  path="/dojo/hiragishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・平岸支部(旧称)</h1>
      </div>

      <h2 class="detail-page__heading">豊平区美園支部・美園空手教室</h2>

      <p class="detail-page__lead">
        (旧平岸空手教室・清心会平岸支部)<br />
        平岸空手教室は、豊平区民センターをお借りして平成21年4月より活動を始めました。<br />
        令和3年3月より会場をコープ美園2Fサークル室に移転し、名称も美園空手教室(<a
          href="/dojo/misono/">美園支部</a
        >)となりました。現在は「美園支部」として活動していますので、最新の稽古日・会場情報は<a
          href="/dojo/misono/">美園支部のページ</a
        >をご覧ください。<br />
        会場がコープなので稽古の間に、お買い物ができますので便利となります。<br />
        設立以来、ジュニア空手として開始し、園児から中学生を中心としています。<br />
        また親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/hiragishi/acs1.jpg"
            alt="平岸支部(現・美園支部)の稽古風景"
            width="336"
            height="185"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/wakabayashi.jpg"
            alt="担当 若林"
            width="105"
            height="105"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/hirabayashi.jpg"
            alt="指導助手 平林"
            width="107"
            height="107"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">平岸支部</h2>
      <p>
        ◆設立　平成21年(2009)4月<br />
        ◆担当　若林
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/コープさっぽろ+美園店/@43.0373071,141.3874316,15z/data=!4m5!3m4!1s0x0:0x72d3e70b77425ccb!8m2!3d43.0373849!4d141.3872843"
          target="_blank"
          rel="noopener">豊平区美園6条7丁目　コープさっぽろ美園2Fサークル室</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/コープさっぽろ+美園店/@43.0373071,141.3874316,15z/data=!4m5!3m4!1s0x0:0x72d3e70b77425ccb!8m2!3d43.0373849!4d141.3872843"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/hiragishi/img4.jpg"
            alt="コープさっぽろ美園店"
            width="240"
            height="168"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <img
          src="/assets/images/legacy/dojo/hiragishi/img18.jpg"
          alt="美園支部"
          width="645"
          height="293"
          loading="lazy"
        />
      </p>

      <p class="detail-page__note">
        ※このページは、旧・平岸支部の情報を残した記録ページです。お申し込み・お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=美園体験申込">事務局</a
        >、または<a href="/dojo/misono/">美園支部のページ</a>からお願いします。<br
        />
        ※2F駐車場からの入口からお入り下さい。分からない時は生協サービスカウンターでお聞き下さい。
      </p>

      <p class="detail-page__back">
        <a href="/dojo/misono/">→ 現在の美園支部のページへ</a><br />
        <a href="/dojo/toyohira/">← 豊平区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
