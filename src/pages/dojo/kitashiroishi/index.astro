---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "北郷支部",
    address: "白石区北郷3条7丁目 北白石地区センター",
    schedule: ["火曜クラス18:30", "金曜クラス15:30"],
  },
];
---

<BaseLayout
  title="白石区北郷支部の空手教室"
  description="札幌市白石区北郷、北白石地区センターを会場にした清心会空手道場・教室のご案内。ジュニア空手クラスの稽古日をご紹介します。"
  lang="ja"
  path="/dojo/kitashiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・北郷支部</h1>
      </div>

      <h2 class="detail-page__heading">白石区北白石空手教室・清心会北白石・北郷支部</h2>

      <p class="detail-page__lead">
        北白石空手教室は、平成10年6月に北郷支部として北郷会館でスタートしました。<br />
        その後、現在の北白石地区センターに会場を移転して活動を継続しています。<br />
        設立以来、ジュニア空手として開始し、園児から中学生を中心としています。<br />
        また親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      {/* instructors={[
        { src: "/assets/images/instructors/namikawa.jpg", alt: "指導 波川", name: "波川" },
        { src: "/assets/images/instructors/takashima.jpg", alt: "指導 高嶋", name: "高嶋" },
      ]} */}
      <BranchInfoCard
        name="清心会北郷支部"
        facts={[
          { label: "設立", value: "平成10年(1998)6月" },
          { label: "設立者", value: "大久保勝美" },
          { label: "歴代", value: "犬浦壽信、波川、佐藤ありさ" },
          { label: "担当", value: "本部直轄" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/kitashiroishi/2.jpg",
          alt: "北白石地区センター",
          width: 247,
          height: 130,
        }}
        address="札幌市白石区北郷3条7丁目9-20 北白石地区センター"
        mapHref="https://www.google.com/maps/place/北白石地区センター/@43.053449,141.424351,15z/data=!4m5!3m4!1s0x0:0x51a3c6bc9843f2f!8m2!3d43.053449!4d141.424351"
        mapQuery="43.053449,141.424351"
        viewOnMapLabel="Google Mapsで見る"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/Image1.jpg"
            alt="北白石支部の稽古風景(火曜クラス)"
            width="276"
            height="101"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/Image2.jpg"
            alt="北白石支部の稽古風景(金曜クラス)"
            width="271"
            height="103"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>

      <DojoContactSection
        dojoName="北郷支部"
        subject="北郷体験・入会問い合わせ"
      />
    </div>
  </section>
</BaseLayout>
