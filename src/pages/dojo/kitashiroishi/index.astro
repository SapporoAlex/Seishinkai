---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "北白石支部(北郷)",
    address: "白石区北郷3条7丁目 北白石地区センター",
    schedule: ["火曜クラス18:30", "金曜クラス15:30"],
  },
];
---

<BaseLayout
  title="白石区北白石支部(北郷)の空手教室"
  description="札幌市白石区北郷、北白石地区センターを会場にした清心会空手道場・教室のご案内。ジュニア空手クラスの稽古日をご紹介します。"
  lang="ja"
  path="/dojo/kitashiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・北白石支部(北郷)</h1>
      </div>

      <p class="detail-page__lead">
        [白石区北白石空手教室・清心会北白石・北郷支部]<br />
        北白石空手教室は、平成10年6月に北郷支部として北郷会館でスタートしました。<br />
        その後、現在の北白石地区センターに会場を移転して活動を継続しています。<br />
        設立以来、ジュニア空手として開始し、園児から中学生を中心としています。<br />
        また親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        火曜日クラス18:30-19:30(担当/波川) 小学生〜大人<br />
        金曜クラス15:30-16:30(担当/高嶋、斎藤) 園児・小学生・親子<br />
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=北郷体験・入会問い合わせ"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/Image1.jpg"
            alt="北白石支部の稽古風景(火曜クラス)"
            width="276"
            height="101"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/Image2.jpg"
            alt="北白石支部の稽古風景(金曜クラス)"
            width="271"
            height="103"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">北郷支部</h2>
      <p>
        ◆設立　平成10年(1998)6月<br />
        ◆設立者　大久保勝美、犬浦壽信<br />
        ◆担当者　波川、嶋、他複数で交代指導
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/北白石地区センター/@43.053449,141.424351,15z/data=!4m5!3m4!1s0x0:0x51a3c6bc9843f2f!8m2!3d43.053449!4d141.424351"
          target="_blank"
          rel="noopener">札幌市白石区北郷3条7丁目9-20 北白石地区センター</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/北白石地区センター/@43.053449,141.424351,15z/data=!4m5!3m4!1s0x0:0x51a3c6bc9843f2f!8m2!3d43.053449!4d141.424351"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/2.jpg"
            alt="北白石地区センター"
            width="247"
            height="130"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=北郷体験・入会問い合わせ">
          <img
            src="/assets/images/legacy/dojo/kitashiroishi/img4.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
