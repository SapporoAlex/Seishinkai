---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import ClassScheduleCard from "@components/ClassScheduleCard.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "★",
    name: "清心館本通道場",
    address: "白石区本通16丁目北(国道12号線沿) 本通清心館",
    schedule: [
      "水曜クラス16:30-17:30",
      "金曜クラス19:00-20:00",
      "日曜特設クラス(新規受付中/3名集まり次第開始)",
    ],
  },
];

const classes = [
  {
    title: "水曜クラス",
    schedule: ["16:30-17:30"],
    instructors: [
      {
        name: "瑠唯",
        position: "内弟子",
        image: "/assets/images/instructors/rui.jpg",
      },
      {
        name: "髙嶋",
        position: "師範補",
        image: "/assets/images/instructors/takashima.jpg",
      },
    ],
  },
  {
    title: "金曜クラス",
    schedule: ["19:00-20:00"],
    instructors: [
      {
        name: "若林 敬司",
        position: "師範代",
        image: "/assets/images/instructors/wakabayashi.jpg",
      },
    ],
  },
  {
    title: "日曜特設クラス",
    schedule: ["新規受付中／3名集まり次第開始"],
    instructors: [
      {
        name: "髙嶋",
        position: "師範補",
        image: "/assets/images/instructors/takashima.jpg",
      },
    ],
  },
];
---

<BaseLayout
  title="白石区本通支部・清心館本通道場の空手教室"
  description="札幌市白石区本通、国道12号線沿いの清心館本通道場のご案内。キッズ・ジュニア空手教室の稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/hondori/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・本通支部</h1>
      </div>

      <p class="detail-page__lead">
        [白石区本通空手教室・清心館本通空手道場]<br />
        本通空手教室は、国道12号線沿いに面する本通清心館道場で平成23年9月(2011)より活動を始めました。<br />
        隣に焼肉の徳寿様、反対隣りにラウンドワンとわかりやすい場所にあります。<br />
        設立以来、キッズ空手、ジュニア空手を中心として開始し、親子での参加も歓迎しています。<br />
        専有道場ですが広くはないので各クラス定員枠15名としています。<br />
        会場はエアコンを完備しています。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=本通体験申込"
          >事務局</a
        >までお願いします。<br />
        開始時刻等若干変動する場合がありますので体験の方は事前にご確認下さい。
      </p>



      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_hondori_05.jpg"
            alt="本通清心館の内観"
            width="234"
            height="144"
            loading="lazy"
          />
          <figcaption>玄関で靴を脱いで正面ドアを開けると階段を下りて下さい。地下に道場があります。</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_hondori_01.jpg"
            alt="本通清心館の内観"
            width="234"
            height="144"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_hondori_02.jpg"
            alt="本通清心館の内観"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hondori/2.jpg"
            alt="本通清心館の外観"
            width="234"
            height="144"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hondori/img5.jpg"
            alt="本通清心館(焼肉徳寿の隣)"
            width="253"
            height="144"
            loading="lazy"
          />
          <figcaption>徳寿の隣にあります</figcaption>
        </figure>
      </div>

      <p class="detail-page__note">
        ※不定期で一般部員有段者が参加します
      </p>

      <BranchInfoCard
        name="本通清心館空手道場"
        facts={[
          { label: "設立", value: "平成23年(2011)4月" },
          { label: "設立者", value: "三村佳代子" },
          { label: "歴代", value: "ハシニ、滝上由佳、高嶋、増田" },
          { label: "指導", value: "若林、瑠唯" },
        ]}
        address="札幌市白石区本通16丁目北12-41(国道12号線沿) 本通清心館"
        addressNote="地下鉄南郷18丁目駅2番出口 徒歩約11分(850m) JRバス「下白石駅」下車徒歩3分、中央バス「本通16丁目」徒歩2分"
        mapHref="https://www.google.com/maps/place/〒003-0027+北海道札幌市白石区本通１６丁目北１２&#8722;４１+キッズ空手教室本通清心館/@43.0360142,141.4332405,19.5z/data=!4m12!1m6!3m5!1s0x5f0b2b0b17d719c7:0x9df984ff883e2c96!2z44OR44OG44Kj44K544Oq44O844OV44Os44O844Or!8m2!3d43.035898!4d141.4338263!3m4!1s0x5f0b2b0b18c518bb:0xad01d582492e34fe!8m2!3d43.036098!4d141.4332991"
        mapQuery="43.0360142,141.4332405"
        viewOnMapLabel="Google Mapsで見る"
      />

      <p class="detail-page__note">
        駐車場はありませんので近隣コインパーキングをご利用ください。ラウンド1外駐車場向かいに<a
          href="https://www.google.com/maps/place/三井のリパーク+札幌本通１６丁目北駐車場/@43.0368883,141.433396,20.75z/data=!4m12!1m6!3m5!1s0x5f0b2b0b17d719c7:0x9df984ff883e2c96!2z44OR44OG44Kj44K544Oq44O844OV44Os44O844Or!8m2!3d43.0462046!4d141.3794742!3m4!1s0x5f0b2b325dd7151b:0x67984f5e45181e18!8m2!3d43.0370477!4d141.4334782"
          target="_blank"
          rel="noopener">三井のリパーク</a
        >があります(本通清心館より140m、徒歩2分)。
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=本通体験申込">
          <img
            src="/assets/images/legacy/dojo/hondori/img1E.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
