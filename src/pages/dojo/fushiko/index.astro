---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "伏古空手クラブ",
    address: "東区伏古7条2丁目8-15 伏古記念会館",
    schedule: ["土曜9:30-10:00(入門者基礎)", "10:00-10:50(6級以下)", "11:00-11:50(5級以上)"],
  },
];
---

<BaseLayout
  title="東区伏古支部の空手教室"
  description="札幌市東区伏古の清心会空手道場・伏古空手クラブのご案内。伏古記念会館での土曜稽古日をご紹介します。"
  lang="ja"
  path="/dojo/fushiko/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・伏古支部</h1>
      </div>

      <p class="detail-page__lead">
        [東区伏古空手教室・清心会伏古支部]<br />
        伏古空手教室は、平成23年11月に、伏古記念会館でスタートしました。<br />
        キッズ空手、ジュニアクラス、親子空手中心の空手クラブです。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=伏古体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/fushiko/Image1.jpg"
            alt="伏古支部の稽古風景"
            width="324"
            height="190"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/tuba.jpg"
            alt="指導 大久保"
            width="108"
            height="105"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">清心会東区伏古支部/伏古空手倶楽部</h2>
      <p>
        ◆設立　平成23年(2011)11月<br />
        ◆指導　大久保翼(2011-)
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒007-0867+北海道札幌市東区伏古７条２丁目８−１５+伏古記念会館/@43.090063,141.3897776,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2ecb7cb8d6fb:0x18450b6d1f6a09e1!8m2!3d43.090063!4d141.3919663"
          target="_blank"
          rel="noopener">札幌市東区伏古7条2丁目8-15　伏古記念会館</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/〒007-0867+北海道札幌市東区伏古７条２丁目８−１５+伏古記念会館/@43.090063,141.3897776,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2ecb7cb8d6fb:0x18450b6d1f6a09e1!8m2!3d43.090063!4d141.3919663"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/fushiko/2.jpg"
            alt="伏古記念会館"
            width="277"
            height="210"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=伏古体験申込">
          <img
            src="/assets/images/legacy/dojo/fushiko/imgA.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/higashi/">← 東区の空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
