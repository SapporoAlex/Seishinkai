---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "●",
    name: "南郷支部(ルーシー文化教室)",
    address: "白石区栄通18丁目 コープさっぽろ(ルーシー文化教室)",
    schedule: ["水曜16:00-17:00"],
  },
];
---

<BaseLayout
  title="白石区南郷支部(ルーシー文化教室)の空手教室"
  description="札幌市白石区栄通、コープさっぽろルーシー文化教室内で行われる清心会南郷支部のジュニア・親子空手教室のご案内です。"
  lang="ja"
  path="/dojo/nango/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・南郷支部</h1>
      </div>

      <p class="detail-page__lead">
        [南郷LUCY空手教室・清心会南郷支部]<br />
        南郷LUCY空手教室は、平成30年6月より体験会を開始し、7月より本格的に活動を始めました。<br />
        南郷支部は、コープさっぽろの「ルーシー文化教室」内で行うジュニア空手、親子空手教室です。<br />
        コープさっぽろの中ですから、お子様が練習中に保護者の方がお買い物をすることができて便利です。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ●講師派遣教室のため、お問い合わせはルーシー文化教室(TEL.011-851-8760 / FAX.011-851-8765)、または清心会事務局(TEL.011-300-0048)までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/nango/Image1.jpg"
            alt="南郷支部の稽古風景"
            width="282"
            height="180"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">清心会ルーシー南郷支部</h2>
      <p>
        ◆設立　平成30年(2018)6月<br />
        ◆歴代　室木、滝上、若林<br />
        ◆担当　室木
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/コープさっぽろ+ルーシー文化教室/@43.028082,141.434141,15z/data=!4m2!3m1!1s0x0:0x1164e7b39eeedaf9"
          target="_blank"
          rel="noopener">札幌市白石区栄通18丁目5-35 コープさっぽろ・ルーシー文化教室</a
        >(地下鉄南郷駅そば)<br />
        主催教室の詳細・お申し込みは<a
          href="https://life-culture.sapporo.coop/culture/course/detail.html/?course_id=795"
          target="_blank"
          rel="noopener">コープさっぽろ ルーシー文化教室のサイト</a
        >をご覧ください。
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/コープさっぽろ+ルーシー文化教室/@43.028082,141.434141,15z/data=!4m2!3m1!1s0x0:0x1164e7b39eeedaf9"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/nango/2.jpg"
            alt="コープさっぽろ ルーシー文化教室"
            width="651"
            height="287"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
