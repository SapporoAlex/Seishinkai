---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "福住支部",
    address: "福住1条1丁目5-5 福住児童会館",
    schedule: ["水曜18:30"],
  },
];
---

<BaseLayout
  title="豊平区福住支部の空手教室"
  description="札幌市豊平区福住の清心会空手道場・教室のご案内。ジュニアクラス中心の空手クラブ、稽古日と会場情報をご紹介します。"
  lang="ja"
  path="/dojo/fukuzumi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・福住支部</h1>
      </div>

      <p class="detail-page__lead">
        [豊平区福住空手教室・清心会福住支部]<br />
        福住空手教室は、福住児童会館をお借りして平成22年9月より活動を始めました。<br />
        設立以来、ジュニア空手として開始し、園児から中学生を中心としています。<br />
        また親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=福住体験申込"
          >事務局</a
        >までお願いします。<br />
        臨時会場　アークス月寒東　月寒東3条8丁目1-30
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/fukuzumi/acs1.jpg"
            alt="福住支部の稽古風景"
            width="308"
            height="189"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/sugimoto.jpg"
            alt="指導 杉本"
            width="107"
            height="110"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/ooba.jpg"
            alt="大場"
            width="106"
            height="106"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">福住支部/福住空手倶楽部</h2>
      <p>
        ◆設立　平成22年(2010)9月<br />
        ◆歴代　風林(2010-2018)<br />
        　　　　室木(2018-2021)<br />
        　　　　嶋(2021-2024)<br />
        ◆指導　杉本(2024-)
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/福住児童会館/@43.020565,141.402402,15z/data=!4m5!3m4!1s0x0:0x749365fd7c50d1bf!8m2!3d43.020565!4d141.402402"
          target="_blank"
          rel="noopener">札幌市豊平区福住1条1丁目5-5　福住児童会館</a
        >
      </p>
      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/fukuzumi/2.jpg"
          alt="福住児童会館"
          width="262"
          height="174"
          loading="lazy"
        />
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=福住体験申込">
          <img
            src="/assets/images/legacy/dojo/fukuzumi/img8.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/toyohira/">← 豊平区空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
