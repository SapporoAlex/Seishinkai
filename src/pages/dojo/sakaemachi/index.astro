---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "栄町空手クラブ",
    address: "東区北42条東19丁目 三愛自動車ビル3F会議室",
    schedule: ["日曜9:30-10:30", "延長クラス10:30-11:00"],
  },
];
---

<BaseLayout
  title="東区栄町支部の空手教室"
  description="札幌市東区北42条の清心会空手道場・栄町空手クラブのご案内。三愛自動車ビル会議室での日曜稽古日をご紹介します。"
  lang="ja"
  path="/dojo/sakaemachi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・栄町支部</h1>
      </div>

      <p class="detail-page__lead">
        [東区栄町空手教室・清心会栄町支部]<br />
        栄町空手教室は、平成15年9月に、三愛自動車工業の会議室をお借りしてスタートした支部です。<br />
        キッズ空手、ジュニア空手、親子空手中心の空手クラブです。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※一部/初級者・小学生は9:30-10:30、延長/中級者以上は一部+10:30-11:00。<br />
        会場は三愛自動車様のご厚意で提供していただいています。駐車の際は駐車位置を指導員にお聞き下さい。研修室以外へは立ち入らないようお願い致します。<br />
        お問い合わせは<a href="mailto:karate@seishinkan.ne.jp?subject=栄町体験申込">事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/sakaemachi/Image1.jpg"
            alt="栄町支部の稽古風景"
            width="336"
            height="189"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/nami.jpg"
            alt="波川師範"
            width="100"
            height="98"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/masuda.jpg"
            alt="指導 ますだ"
            width="94"
            height="97"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">東区栄町支部</h2>
      <p>
        ◆設立　平成15年(2003)9月<br />
        ◆設立者　三村佳代子、波川和明<br />
        ◆歴代　ハシニ<br />
        ◆担当者　波川
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a href="http://yahoo.jp/JbqUqo" target="_blank" rel="noopener"
          >札幌市東区北42条東19丁目1-1　三愛自動車</a
        >
      </p>
      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/sakaemachi/2.jpg"
          alt="三愛自動車ビル"
          width="521"
          height="225"
          loading="lazy"
        />
      </div>

      <p class="detail-page__back">
        <a href="/dojo/higashi/">← 東区の空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
