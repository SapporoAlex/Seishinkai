            alt="総本部別館・鍛錬道場の砂袋"
            width="268"
            height="180"
            loading="lazy"
          />
          <figcaption>総本部別館・鍛錬道場(砂袋)</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/hon2.jpg"
            alt="総本部別館・鍛錬道場の木人拳"
            width="265"
            height="185"
            loading="lazy"
          />
          <figcaption>総本部別館・鍛錬道場(木人拳)</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/Image1_sc.jpg"
            alt="総本部別館・鍛錬道場"
            width="266"
            height="193"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">所在地</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒003-0021+北海道札幌市白石区栄通２丁目１−２７/@43.0409785,141.3938016,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bb4690b9e5f:0x622b301003410409!8m2!3d43.0409785!4d141.3959903"
          target="_blank"
          rel="noopener">札幌市白石区栄通2丁目1-27</a
        ><br />
        NPO法人全日本清心会事務局内
      </p>

      <p class="detail-page__back">
        <a href="/dojo/">← 空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
