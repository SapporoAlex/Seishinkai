---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "本町空手クラブ(本町支部/旧苗穂支部)",
    address: "東区本町2条7丁目1 本町小学校内・苗穂本町児童会館",
    schedule: ["休止中(R6.5〜)"],
  },
];
---

<BaseLayout
  title="東区本町支部(旧苗穂支部)の空手教室"
  description="札幌市東区本町の清心会空手道場・本町支部(旧苗穂支部)のご案内。苗穂本町児童会館を会場としていましたが現在休止中です。"
  lang="ja"
  path="/dojo/naebo/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・本町支部(旧苗穂支部)</h1>
      </div>

      <h2 class="detail-page__heading">東区本町空手教室・清心会本町支部</h2>

      <p class="detail-page__lead">
        <strong>現在、休止中です。</strong><br />
        苗穂空手教室は、平成22年10月に、苗穂児童会館でスタートしましたが、令和5年より苗穂児童会館が本町小学校内に移転し「苗穂本町児童会館」となり本町空手教室として新スタートを致しました。<br />
        キッズ空手、ジュニア空手中心の空手クラブです。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <BranchInfoCard
        name="東区苗穂支部"
        facts={[
          { label: "設立", value: "平成22年(2010)10月" },
          { label: "設立者", value: "三村佳代子" },
          { label: "歴代", value: "ハシニ、滝上、前川" },
          { label: "担当者", value: "増田" },
        ]}
        instructors={[
          { src: "/assets/images/legacy/clubu/maekawa2.jpg", alt: "指導 前川", name: "前川" },
          { src: "/assets/images/instructors/masuda.jpg", alt: "担当者 増田", name: "増田" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/naebo/img3.jpg",
          alt: "苗穂本町児童会館",
          width: 244,
          height: 138,
        }}
        address="札幌市東区本町2条7丁目1　本町小学校内・苗穂本町児童会館"
        addressNote="令和5年4月より苗穂児童会館は本町小学校内に移転となりました。〒065-0042"
        mapHref="https://www.google.com/maps/place/札幌市立本町小学校/@43.0754469,141.3902726,18z/data=!4m23!1m16!4m15!1m6!1m2!1s0x5f0b294feae3439b:0x613a14a89c37ed46!2z5pyt5bmM5biC56uL5pys55S65bCP5a2m5qCh44CB44CSMDY1LTAwNDIg5YyX5rW36YGT5pyt5bmM5biC5p2x5Yy65pys55S677yS5p2h77yX5LiB55uu77yR!2m2!1d141.3934231!2d43.0763174!1m6!1m2!1s0x5f0b29451b852511:0x21d072c862c501d5!2z44CSMDY1LTAwNDMg5YyX5rW36YGT5pyt5bmM5biC5p2x5Yy66IuX56mC55S677yV5LiB55uu77yX4oiS77yRIOacreW5jOW4guiLl-epguWFkOerpeS8mumkqA!2m2!1d141.3886617!2d43.0751405!3e2!3m5!1s0x5f0b294feae3439b:0x613a14a89c37ed46!8m2!3d43.0763316!4d141.3931049!16s/g/1tkp4s8_"
        mapQuery="43.0754469,141.3902726"
        viewOnMapLabel="Google Mapsで見る"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/naebo/Image1.jpg"
            alt="本町支部(旧苗穂支部)の稽古風景"
            width="1022"
            height="546"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        ※R6.5より一時休止。2010年より活動し2024年4月末で一旦、当会場での活動を休止しています。5名程度集まりましたら再開したいと思いますので希望者はお声かけ下さい。<br />
        
      </p>

      <p class="detail-page__back">
        <a href="/dojo/higashi/">← 東区の空手道場・教室の一覧へ戻る</a>
      </p>

      <DojoContactSection
        dojoName="本町支部(旧苗穂支部)"
        subject="苗穂 体験・入会問い合わせ"
      />
    </div>
  </section>
</BaseLayout>
