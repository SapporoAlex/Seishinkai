---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "菊水支部",
    address: "白石区菊水3条5丁目 アークス菊水店2F",
    schedule: ["水曜クラス17:45", "木曜クラス18:45", "土曜クラス13:00"],
  },
];
---

<BaseLayout
  title="白石区菊水支部の空手教室"
  description="札幌市白石区菊水、アークス菊水店2Fを会場にした清心会空手道場・教室のご案内。ジュニア空手クラスの稽古日をご紹介します。"
  lang="ja"
  path="/dojo/kikusui/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・菊水支部</h1>
      </div>

      <p class="detail-page__lead">
        [菊水空手教室・清心会菊水支部]<br />
        菊水空手教室は、アークス菊水店2Fコミュニティスペースをお借りして平成23年3月より活動を始めました。<br />
        設立以来、ジュニア空手として開始し、園児から中学生を中心としています。<br />
        また親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=菊水体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/kikusui/Image3.jpg"
            alt="菊水支部の稽古風景(水曜・木曜クラス)"
            width="251"
            height="136"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/kikusui/Image2.jpg"
            alt="菊水支部の稽古風景(土曜クラス)"
            width="251"
            height="137"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">菊水支部</h2>
      <p>
        ◆設立　平成23年(2011)3月<br />
        ■指導　複数指導員(一般部員)が交代で指導
      </p>

      <p class="detail-page__note">交代で指導する一般部メンバー</p>
      <div class="detail-media">
        <figure>
          <img
            src="/assets/images/instructors/maekawa.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/oikawa.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/takashima.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/masuda.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/shima.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/noro.jpg"
            alt=""
            width="100"
            height="100"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒003-0803+北海道札幌市白石区菊水３条５丁目２&#8722;２５+アークス/@43.0529182,141.3763685,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bd3eb0399f1:0xf3795c85cd820460!8m2!3d43.0529182!4d141.3785572"
          target="_blank"
          rel="noopener">札幌市白石区菊水3条5丁目2-25 アークス菊水店</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/〒003-0803+北海道札幌市白石区菊水３条５丁目２&#8722;２５+アークス/@43.0529182,141.3763685,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bd3eb0399f1:0xf3795c85cd820460!8m2!3d43.0529182!4d141.3785572"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/kikusui/acs1.jpg"
            alt="アークス菊水店"
            width="248"
            height="138"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=菊水体験申込">
          <img
            src="/assets/images/legacy/dojo/kikusui/img22.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/shiroishi/">← 白石区の空手教室一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
