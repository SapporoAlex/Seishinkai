---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "東雁来空手クラブ",
    address: "東区東雁来14条2丁目1-1 東雁来児童会館",
    schedule: ["木曜18:30"],
  },
];
---

<BaseLayout
  title="東区東雁来支部の空手教室"
  description="札幌市東区東雁来の清心会空手道場・東雁来空手クラブのご案内。東雁来児童会館での木曜稽古日をご紹介します。"
  lang="ja"
  path="/dojo/higashikariki/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">清心会空手道連盟・東雁来支部</h1>
      </div>

      <p class="detail-page__lead">
        [東雁来空手教室・清心会東雁来支部]<br />
        東雁来空手教室は、令和3年2月に開始した空手教室です。<br />
        子供から大人まで楽しく学べる空手です。<br />
        特に親子での参加、シニアクラスの参加者を歓迎します。<br />
        体育会系部活の延長線上のような道場が多い中、健康・体育の空手としてサークル感覚で楽しく練習して学ぶことを目指しています。<br />
        担当指導員は幼稚園勤務経験(幼稚園教諭免許)がありますので特に園児、低学年においては安心してお預け下さい。
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        ※会場は施設をお借りしていますので、お問い合わせは<a
          href="mailto:karate@seishinkan.ne.jp?subject=東雁来体験申込"
          >事務局</a
        >までお願いします。
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/higashikariki/img7.jpg"
            alt="東雁来支部の稽古風景"
            width="611"
            height="216"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/manaya.jpg"
            alt="指導員"
            width="142"
            height="142"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">札幌市東区・東雁来支部</h2>
      <p>
        ◆設立　令和3年(2021)2月<br />
        ◆設立者　猪又<br />
        ◇本部直轄　斎藤
      </p>

      <h2 class="detail-page__heading">会場</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/札幌市東雁来児童会館+かりたま/@43.105653,141.4308999,15z/data=!4m5!3m4!1s0x0:0xeb5bbea1f521e82b!8m2!3d43.1056214!4d141.4308765"
          target="_blank"
          rel="noopener">札幌市東区東雁来14条2丁目1-1　東雁来児童会館</a
        >
      </p>
      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/higashikariki/img3.jpg"
          alt="東雁来児童会館"
          width="437"
          height="239"
          loading="lazy"
        />
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=東雁来体験申込">
          <img
            src="/assets/images/legacy/dojo/higashikariki/img16.jpg"
            alt="体験申込はこちら"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/dojo/higashi/">← 東区の空手道場・教室の一覧へ戻る</a>
      </p>
    </div>
  </section>
</BaseLayout>
