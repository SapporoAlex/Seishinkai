---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Eniwa City Karate Club",
    address: "389-3 Minami-Shimamatsu, Eniwa City (Shimamatsu Gymnasium)",
    schedule: ["Friday 16:00 (since Feb. 2022)"],
  },
];
---

<BaseLayout
  title="Karate Classes in Eniwa City (Shimamatsu Karate)"
  description="Information about the Seishinkai Karate dojo/class held at Shimamatsu Gymnasium in Minami-Shimamatsu, Eniwa City. A kids- and junior-focused karate club — find training days and venue details here."
  lang="en"
  path="/en/dojo/eniwa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Eniwa Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Eniwa City Karate Class — Seishinkai Eniwa Branch] Shimamatsu Karate / Emino Karate<br />
        The Eniwa karate class started in March 2013 (Heisei 25).<br />
        The venue is Shimamatsu Gymnasium.<br />
        The class focuses mainly on Kids and Junior classes. Parent-child participation and Senior Class members are also welcome.<br />
        While many dojos feel like an extension of school sports-club activities, we aim for karate as health and fitness training — practicing and learning together in a relaxed, club-like atmosphere.<br />
        ※A free monthly campaign is currently running for 3-year-olds attending together with a parent.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Eniwa Trial Lesson & Membership Inquiry"
          >office</a
        >.<br />
        In addition to Shimamatsu Gymnasium, practice sometimes takes place in the Co-op Eniwa meeting room.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/eniwa/Image1.jpg"
            alt="Eniwa Branch practice session"
            width="261"
            height="111"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/eniwa/2.jpg"
            alt="Shimamatsu Gymnasium"
            width="254"
            height="160"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Eniwa Branch</h2>
      <p>
        ◆ Founded: March 2013 (Heisei 25)<br />
        ◆ Assistant Master (Shihandai): Kazuya Shima<br />
        ◆ Instructor: Directly overseen by Headquarters<br />
        ◆ Instructor in charge: Maekawa (multiple instructors rotate in this role)
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/島松体育館/@42.917452,141.5843139,15z/data=!4m2!3m1!1s0x0:0x800612839adc2133?sa=X&ved=2ahUKEwito5C8wK_hAhXaM94KHU4BD9wQ_BIwCnoECA8QCA"
          target="_blank"
          rel="noopener">389-3 Minami-Shimamatsu, Eniwa City, Shimamatsu Gymnasium</a
        >
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Eniwa Trial Lesson & Membership Inquiry">
          <img
            src="/assets/images/legacy/images/Image2.jpg"
            alt="Apply for a trial lesson or membership"
            width="645"
            height="260"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/kitahiro/">← Back to the list of dojos & classes in Obihiro, Eniwa & Asahikawa</a>
      </p>
    </div>
  </section>
</BaseLayout>
