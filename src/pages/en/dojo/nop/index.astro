---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "#",
    name: "Nopporo Karate Club",
    address: "23-6 Nopporo-tondencho, Ebetsu, Morinodai Memorial Hall",
    schedule: ["Wednesday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes in Nopporo, Ebetsu City"
  description="Information on the Seishinkai karate dojo/class in Nopporo, Ebetsu City. A junior-focused karate club held at the Morinodai Memorial Hall — details on training days and venue."
  lang="en"
  path="/en/dojo/nop/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Nopporo Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Nopporo Karate Class, Ebetsu City / Seishinkai Nopporo Branch]<br />
        The Nopporo Karate Class started in October 2007 (Heisei 19) at the Morinodai Memorial Hall, along Sanban-dori in Ebetsu.<br />
        It is a karate club focused mainly on the Junior Class.<br />
        We especially welcome parent-child participants and members of our Senior Class.<br />
        While many dojos feel like an extension of school sports-club activities, we aim for karate as health and fitness training — practicing and learning together in a relaxed, club-like atmosphere.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Nopporo Trial Lesson Application"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/clubu/shima.jpg"
            alt="Instructor: Shima"
            width="126"
            height="126"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/nop/Image1.jpg"
            alt="Nopporo Branch practice session"
            width="243"
            height="122"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Nopporo Branch, Ebetsu City</h2>
      <p>
        ◆ Founded: October 2007 (Heisei 19)<br />
        ◆ Founder: Takayuki Inomata<br />
        ◆ Past instructors: Tsubasa Okubo, Kazuya Shima, and others, Saori Okimura<br />
        ◆ Instructor: Fuyuki Shima
      </p>

      <h2 class="detail-page__heading">Venue: Ebetsu Nopporo Karate Dojo</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒069-0803+北海道江別市野幌屯田町２３−６/@43.0969071,141.5075755,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2dee41c4efab:0x240f6398f59169be!8m2!3d43.0969071!4d141.5097642"
          target="_blank"
          rel="noopener">23-6 Nopporo-tondencho, Ebetsu, Morinodai Memorial Hall 2F</a
        ><br />
        Located along Sanban-dori.
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/〒069-0803+北海道江別市野幌屯田町２３−６/@43.0969071,141.5075755,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2dee41c4efab:0x240f6398f59169be!8m2!3d43.0969071!4d141.5097642"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/nop/2.jpg"
            alt="Morinodai Memorial Hall"
            width="192"
            height="100"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Nopporo Trial Lesson Application">
          <img
            src="/assets/images/legacy/dojo/nop/img3.jpg"
            alt="Apply for a trial lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/ebetsu/">← Back to the list of dojos & classes in Ebetsu, Iwamizawa & Ishikari</a>
      </p>
    </div>
  </section>
</BaseLayout>
