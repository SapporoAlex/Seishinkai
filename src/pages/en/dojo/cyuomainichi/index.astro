---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Sapporo Chuo Branch",
    address: "Nijo Harunire Jido Kaikan (inside Nijo Elementary School), Minami 2-jo Nishi 15-chome, Chuo-ku",
    schedule: ["Tuesday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Sapporo Chuo Branch, Chuo Ward"
  description="Introducing the Sapporo Chuo Branch of Seishinkai Karate at Nijo Harunire Jido Kaikan in Chuo Ward, Sapporo. See training days and venue information."
  lang="en"
  path="/en/dojo/cyuomainichi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Chuo Branch</h1>
      </div>

      <h2 class="detail-page__heading">Chuo Ward Chuo Karate Class - Seishinkai Sapporo Chuo Branch</h2>

      <p class="detail-page__lead">
        The Chuo karate class began in April 2002 (Heisei 14), centered on working adults, as the Yomiuri Culture Class in the basement of the Yomiuri Shimbun Sapporo Building.<br />
        In 2004 (Heisei 16), when the Yomiuri building was rebuilt, the class moved to the basement of the Mainichi Shimbun building; when fire-code regulations made that space unusable, it moved to the Minami 1-jo Building in 2009 (Heisei 21), where a Junior class was newly established while the General class continued at the same time at the Chuo Ward Community Center. In 2011 (Heisei 23) the two were consolidated and the class operated out of the Ward Community Center, before moving to its current location, Nijo Harunire Jido Kaikan, in 2018 (Heisei 30).<br />
        Participation by parents and children together, as well as senior class members, is especially welcome.<br />
        While many dojos feel like an extension of a school sports club, this one aims to offer karate for health and fitness that members can enjoy learning in a relaxed, club-like atmosphere.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <BranchInfoCard
        name="Sapporo Chuo Branch"
        facts={[
          { label: "Founded", value: "April 2002 (Heisei 14)" },
          { label: "Founder", value: "Katsumi Okubo" },
          { label: "Former Instructors", value: "Muroki, Maekawa" },
          { label: "Instructor", value: "Yoshihiko Oikawa" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/cyuomainichi/2.jpg",
          alt: "Nijo Harunire Jido Kaikan",
          width: 251,
          height: 193,
        }}
        instructors={[
          { src: "/assets/images/instructors/oikawa.jpg", alt: "Instructor Yoshihiko Oikawa", name: "Yoshihiko Oikawa" },
        ]}
        address="Minami 2-jo Nishi 15-chome, Chuo-ku, Sapporo, inside Nijo Elementary School (Nijo Harunire Jido Kaikan)"
        addressNote="Located inside Nijo Elementary School."
        mapHref="https://www.google.com/maps/place/札幌市立二条小学校/@43.0546877,141.3355023,19z/data=!4m12!1m6!3m5!1s0x5f0b296539865b81:0x2362591de0c135a3!2z6IuX56mC44Gv44KL44Gr44KM5YWQ56ul5Lya6aSo!8m2!3d43.0656597!4d141.3716306!3m4!1s0x5f0b29924b409247:0x82c534a0c088c48b!8m2!3d43.0547571!4d141.3355527"
        mapQuery="43.0546877,141.3355023"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/cyuomainichi/Image1.jpg"
            alt="Training session at the Chuo Branch"
            width="299"
            height="154"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">History of the Chuo Branch</h2>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_chuoumainichi_02.jpg"
            alt="Yomiuri Culture Class (2002-2004)"
            width="249"
            height="150"
            loading="lazy"
          />
          <figcaption>Yomiuri Culture Class (2002-2004)</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuoumainichi_03.jpg"
            alt="Mainichi Kaikan (2004-2009)"
            width="255"
            height="155"
            loading="lazy"
          />
          <figcaption>Mainichi Kaikan (2004-2009)</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuoumainichi_05.jpg"
            alt="Minami 1-jo Building (2009-2011)"
            width="377"
            height="242"
            loading="lazy"
          />
          <figcaption>Minami 1-jo Building (2009-2011)</figcaption>
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/cyuo/">← Back to the Chuo Ward dojo & class list</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Chuo Branch"
        subject="Chuo Branch Trial Lesson Application"
      />
    </div>
  </section>
</BaseLayout>
