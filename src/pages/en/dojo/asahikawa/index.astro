---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "Asahikawa Karate Club for Foreign Residents",
    address: "Asahikawa City (venue being arranged)",
    schedule: ["TBD (currently recruiting members)"],
  },
];
---

<BaseLayout
  title="Karate Classes for Foreign Residents in Asahikawa City"
  description="A Seishinkai Karate club exclusively for foreign residents living in Asahikawa. Currently recruiting members — classes will begin once preparations are complete."
  lang="en"
  path="/en/dojo/asahikawa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Asahikawa Karate Club for Foreign Residents</h1>
      </div>

      <h2 class="detail-page__heading">Asahikawa Karate Class for Foreign Residents — Seishinkai Asahikawa Branch</h2>

      <p class="detail-page__lead">
        In preparation<br />
        We are preparing a karate club exclusively for foreign residents living in Asahikawa.<br />
        If you are interested, please let us know.<br />
        It will start as soon as enough members have gathered.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <BranchInfoCard
        name="Asahikawa Karate Club for Foreign Residents"
        facts={[
          { label: "Founder", value: "Shogo Inoue" },
          { label: "Facebook", value: "Shogo Inoue" },
        ]}
      />

      <div class="detail-gallery">
        <figure>
          <a href="https://www.facebook.com/profile.php?id=100004664102435">
            <img
              src="/assets/images/legacy/clubu/inoueshogo.jpg"
              alt="Founder: Shogo Inoue (Facebook)"
              width="148"
              height="148"
              loading="lazy"
            />
          </a>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/asahikawa/Image2.jpg"
            alt="Asahikawa Karate Club for Foreign Residents"
            width="353"
            height="276"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/kitahiro/">← Back to the list of dojos & classes in Obihiro, Eniwa & Asahikawa</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Asahikawa Karate Club for Foreign Residents"
        subject="Asahikawa Karate Inquiry"
      />
    </div>
  </section>
</BaseLayout>
