---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "#",
    name: "Minami-ku Tokiwa Karate Class (Seishinkai Tokiwa Branch)",
    sub: "Tokiwa Karate Club",
    address: "1-jo 1-chome 3-1 Tokiwa, Minami-ku, Sapporo, Tokiwa Danchi Hall",
    schedule: ["Monday 4:30-5:30 PM"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Tokiwa Branch"
  description="Introducing the Seishinkai karate class at the Tokiwa Danchi Hall in Minami-ku, Sapporo. Focused on kids and junior karate, with training days and venue information."
  lang="en"
  path="/en/dojo/tokiwa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Tokiwa Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Minami-ku Tokiwa Karate Class - Seishinkai Tokiwa Branch]<br />
        The Tokiwa Karate Class started in September 2012 (Heisei 24). It began at the neighborhood hall, later moved to the Tokiwa Children's Hall, and has since returned to holding activities at the Tokiwa Danchi Hall (from April 2020, Reiwa 2).<br />
        As a kids' and junior karate class, we would like to focus mainly on children from preschool age through junior high school. We are currently recruiting trial students!<br />
        Participation by parents and children together, and by senior members, is also welcome.<br />
        While many dojos feel like an extension of school sports clubs, we aim for members to practice and learn in a relaxed, club-like atmosphere as health-oriented, physical-education-style karate.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Tokiwa Branch Trial Lesson / Enrollment Inquiry"
          >office</a
        >.<br />
        ※Due to the impact of COVID-19, the venue was temporarily moved to the following location: 1-jo 1-chome 3-1 Tokiwa, Minami-ku <a
          href="https://www.google.com/maps/place/〒005-0851+北海道札幌市南区常盤１条１丁目３−１+常盤団地会館/@42.955108,141.344939,17z/data=!3m1!4b1!4m5!3m4!1s0x5f752b30e3655f31:0x43a4187663d955fc!8m2!3d42.9551041!4d141.3471277"
          target="_blank"
          rel="noopener">Tokiwa Danchi Hall</a
        >
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/tokiwa/acs1.jpg"
            alt="Tokiwa Branch practice session"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Minami-ku Tokiwa Branch / Tokiwa Karate Club</h2>
      <p>
        ◆Founded: September 2012 (Heisei 24)<br />
        ◆Founder: Takushi Muroki (2012-2020)<br />
        ◆Past leads: Yutaka Yamane (2013-2014)<br />
        　　　　Yoshihiko Oikawa (2020-2022)<br />
        　　　　Saori Okimura (2022-)
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/clubu/okimura.jpg"
            alt="Instructor Okimura"
            width="105"
            height="105"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/常盤児童会館/@42.948119,141.347944,15z/data=!4m5!3m4!1s0x0:0xd28fbfc8404d010!8m2!3d42.948119!4d141.347944"
          target="_blank"
          rel="noopener">2-jo 2-chome 17-23 Tokiwa, Minami-ku, Sapporo, Tokiwa Children's Hall</a
        >
      </p>
      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/tokiwa/img2.jpg"
          alt="Tokiwa Danchi Hall"
          width="259"
          height="161"
          loading="lazy"
        />
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Tokiwa Branch Trial Lesson / Enrollment Inquiry">
          <img
            src="/assets/images/legacy/dojo/tokiwa/img8.jpg"
            alt="Click here to apply for a trial lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the Kiyota Ward & Minami Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
