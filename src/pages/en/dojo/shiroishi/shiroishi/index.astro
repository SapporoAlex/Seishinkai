---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "",
    name: "Shiroishi Headquarters",
    address: "Shiroishi Welfare Hall, 4-36 Chuo 1-jo 5-chome, Shiroishi-ku, Sapporo",
    schedule: ["Thursday Class", "①18:30", "②19:30"],
  },
];
---

<BaseLayout
  title="Seishinkan Shiroishi Karate Dojo (Shiroishi Headquarters)"
  description="Information about the Seishinkan Shiroishi Headquarters Dojo in Shiroishi Ward, Sapporo. Learn about our karate classes for children and juniors, training schedule, and venue."
  lang="en"
  path="/en/dojo/shiroishi/shiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkan Shiroishi Karate Dojo (Shiroishi Headquarters)</h1>
      </div>

      <h2 class="detail-page__heading">Karate Dojo in Shiroishi Ward</h2>

      <div class="detail-page__img-text-pair--reverse">
        <div class="detail-media--med">
          <figure>
            <img
              src="/assets/images/dojo/img_shiroishi_2.jpg"
              alt="Shiroishi Welfare Hall"
              width="253"
              height="144"
              loading="lazy"
            />
            <figcaption>
              Since August 2026, Thursday classes have been held on the 2nd floor of Shiroishi Welfare Hall.
            </figcaption>
          </figure>
        </div>

        <p>
          The Headquarters Dojo was established as a permanent training facility in
          <strong>March 1986</strong> in Shiroishi Ward, Sapporo. Including its years as
          the former Sapporo Branch, it has served the community for over
          <strong>50 years</strong>, making it one of Sapporo's longest-established
          karate dojos.<br /><br />

          It served as the organization's Headquarters Dojo until the current
          Seishinkai Headquarters building on Sakae-dori in Shiroishi Ward was
          completed in <strong>2012</strong>.<br /><br />

          Since <strong>August 2026</strong>, training has been held on the
          <strong>2nd Floor of Shiroishi Welfare Hall</strong>.<br /><br />

          As one of the oldest karate dojos in Shiroishi Ward, instruction is provided
          directly under the supervision of Headquarters, with experienced black belt
          instructors rotating teaching duties.<br /><br />

          Today, the dojo primarily offers junior classes for preschool, elementary,
          and junior high school students.<br /><br />

          The venue is conveniently located between National Route 12 and Hongō-dōri.
        </p>
      </div>

      <div class="detail-page__img-text-pair">
        <div class="detail-gallery">
          <figure>
            <img
              src="/assets/images/dojo/img_shiroishi_6.jpg"
              alt="Exterior of Shiroishi Welfare Hall"
              width="234"
              height="144"
              loading="lazy"
            />
          </figure>

          <figure>
            <img
              src="/assets/images/dojo/img_shiroishi_5.jpg"
              alt="Training hall"
              width="234"
              height="144"
              loading="lazy"
            />
          </figure>
        </div>
      </div>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        * Classes are held using facilities at Shiroishi Welfare Hall.<br />
        * As this venue is rented, please contact the
        <a
          href="mailto:karate@seishinkan.ne.jp?subject=Shiroishi Welfare Hall Trial Lesson & Membership Inquiry"
        >
          Administration Office
        </a>
        for all inquiries.
      </p>

      <div class="dojo-list__map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2915.4130221087366!2d141.3980022!3d43.0537802!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f0b2bc48025a535%3A0xb5799aa9afba892d!2sShiroishi%20Ch%C5%AB%C5%8D%20Welfare%20Hall!5e0!3m2!1sen!2sjp!4v1785046476874!5m2!1sen!2sjp"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

      <p class="detail-page__note">
        Approximately 14 minutes on foot (1.1 km) from Shiroishi Subway Station.<br />
        About a 2-minute walk from the Chuo 1-4 bus stop (Chuo Bus), or a
        5-minute walk from the Chuo 1-3 bus stop (JR Bus).<br />
        TEL: +81-11-300-0048<br />
        Office hours: Weekdays 1:00 PM–3:00 PM.<br />
        Please note that phone calls cannot be answered during evening training sessions.
      </p>

      <h2 class="detail-page__heading">
        Home of the Headquarters Dojo for 21 Years (2005 – July 2026)
      </h2>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_3.jpg"
            alt="Former Headquarters Dojo"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_4.jpg"
            alt="Former Headquarters Dojo"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/shiroishi/">← Back to Shiroishi Ward Dojos</a>
      </p>
    </div>
  </section>
</BaseLayout>