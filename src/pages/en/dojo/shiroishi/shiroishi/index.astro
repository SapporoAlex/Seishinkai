---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "",
    name: "Shiroishi Headquarters",
    address: "Shiroishi Welfare Hall, 4-36 Chuo 1-jo 5-chome, Shiroishi-ku, Sapporo",
    schedule: ["Thursday Class", "①18:30", "②19:30"],
  },
];
---

<BaseLayout
  title="Seishinkan Shiroishi Karate Dojo (Shiroishi Headquarters)"
  description="Information about Seishinkan Shiroishi Karate Dojo in Shiroishi Ward, Sapporo. Find class schedules, venue details, and junior karate lessons."
  lang="en"
  path="/en/dojo/shiroishi/shiroishi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkan Shiroishi Karate Dojo (Shiroishi Headquarters)</h1>
      </div>

      <h2 class="detail-page__heading">Karate Dojo in Shiroishi Ward</h2>

      <div class="detail-page__img-text-pair--reverse">
        <div class="detail-media--med">
          <figure>
            <img
              src="/assets/images/dojo/img_shiroishi_1.jpg"
              alt="Exterior of the Shiroishi Headquarters Dojo"
              width="234"
              height="144"
              loading="lazy"
            />
          </figure>
        </div>

        <p>
          The Headquarters Dojo was established as a permanent training facility
          in Shiroishi Ward in March 1986 and has remained active for more than
          35 years.<br />
          Counting from the days of the former Sapporo Branch, karate training
          has continued here for over 40 years, making it one of Sapporo's
          longest-established karate dojos.<br />
          Until the federation's General Headquarters was established in 2012,
          this facility served as the main headquarters dojo. It is now known as
          the permanent <strong>Shiroishi Dojo</strong>.<br />
          From August 2026, training moved to the 2nd floor of the Shiroishi
          Welfare Hall.<br />
          It is considered one of the oldest karate dojos in Shiroishi Ward and
          is operated directly by Seishinkai, with instructors rotating on a
          regular basis.<br />
          Today, the dojo primarily offers junior classes for kindergarten and
          junior high school students.<br />
          The venue is conveniently located between National Route 12 and
          Hongō-dori.
        </p>
      </div>

      <div class="detail-page__img-text-pair">
        <div class="detail-gallery">
          <figure>
            <img
              src="/assets/images/dojo/img_shiroishi_2.jpg"
              alt="Shiroishi Welfare Hall"
              width="253"
              height="144"
              loading="lazy"
            />
            <figcaption>
              From August 2026, Thursday classes are held from 6:30 pm on the
              2nd floor of Shiroishi Welfare Hall.
            </figcaption>
          </figure>
        </div>
      </div>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        * Training is held using the facilities at Shiroishi Welfare Hall (Shiroishi Chuo Fukushi Kaikan).<br>
        * As this venue is a facility we use with permission, please direct all inquiries to the
        <a
          href="mailto:karate@seishinkan.ne.jp?subject=Trial Lesson & Membership Inquiry (白石中央福祉会館 体験・入会問い合わせ)"
        >
          Administrative Office
        </a>.
      </p>

      <div class="dojo-list__map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2915.4130221087366!2d141.3980022!3d43.0537802!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5f0b2bc48025a535%3A0xb5799aa9afba892d!2sShiroishi%20Ch%C5%AB%C5%8D%20Welfare%20Hall!5e0!3m2!1sen!2sjp!4v1785046476874!5m2!1sen!2sjp"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>

      <p class="detail-page__note">
        Approximately a 14-minute walk (1.1 km) from Shiroishi Subway Station.<br />
        About a 2-minute walk from the Chuo 1-4 bus stop (Chuo Bus), or a
        5-minute walk from the Chuo 1-3 bus stop (JR Bus).<br />
        Tel: +81-11-300-0048 (Weekdays 1:00 pm – 3:00 pm). Please note that we
        may be unable to answer the phone during evening training sessions.
      </p>

      <h2 class="detail-page__heading">
        This venue served as our dojo for 21 years (2005 – July 2026)
      </h2>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_3.jpg"
            alt="Former Shiroishi Dojo"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/dojo/img_shiroishi_4.jpg"
            alt="Former Shiroishi Dojo building"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/shiroishi/">← Back to Shiroishi Ward Dojos</a>
      </p>
    </div>
  </section>
</BaseLayout>