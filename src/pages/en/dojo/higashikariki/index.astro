---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Higashi-Kaerai Karate Club",
    address: "Higashi-Kaerai Children's Hall, Higashi-Kaerai 14-jo 2-chome 1-1, Higashi-ku, Sapporo",
    schedule: ["Thursday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Higashi-Kaerai Branch, Higashi Ward"
  description="Introducing the Higashi-Kaerai Karate Club, a Seishinkai Karate dojo in Higashi-Kaerai, Higashi Ward, Sapporo. Training is held on Thursdays at the Higashi-Kaerai Children's Hall."
  lang="en"
  path="/en/dojo/higashikariki/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation — Higashi-Kaerai Branch</h1>
      </div>

      <h2 class="detail-page__heading">Higashi-Kaerai Karate Class / Seishinkai Higashi-Kaerai Branch</h2>

      <p class="detail-page__lead">
        The Higashi-Kaerai karate class got its start in February 2021 (Reiwa 3) at the Higashi-Kaerai Community Hall, moving the following year to the Higashi-Kaerai Children's Hall.<br />
        It's karate that people of all ages, from kids to adults, can enjoy learning.<br />
        Participation by parents and children together, and by senior class members, is especially welcome.<br />
        While many dojos feel like an extension of a school sports club, this one aims to offer karate for health and fitness that members can enjoy learning in a relaxed, club-like atmosphere.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <BranchInfoCard
        name="Seishinkai Higashi-Kaerai Branch"
        facts={[
          { label: "Founded", value: "February 2021 (Reiwa 3)" },
          { label: "Founder", value: "Takayuki Inomata" },
          { label: "Instructor", value: "Directly overseen by Headquarters — Saito, plus rotating adult black belt members joining occasionally" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/higashikariki/img3.jpg",
          alt: "Higashi-Kaerai Children's Hall",
          width: 437,
          height: 239,
        }}
        address="Higashi-Kaerai Children's Hall, Higashi-Kaerai 14-jo 2-chome 1-1, Higashi-ku, Sapporo"
        mapHref="https://www.google.com/maps/place/札幌市東雁来児童会館+かりたま/@43.105653,141.4308999,15z/data=!4m5!3m4!1s0x0:0xeb5bbea1f521e82b!8m2!3d43.1056214!4d141.4308765"
        mapQuery="43.105653,141.4308999"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/higashikariki/img7.jpg"
            alt="Practice session at the Higashi-Kaerai Branch"
            width="611"
            height="216"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/manaya.jpg"
            alt="Instructor"
            width="142"
            height="142"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/higashi/">← Back to the Higashi Ward Dojo & Class List</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Higashi-Kaerai Branch"
        subject="Higashi-Kaerai Trial Application"
      />
    </div>
  </section>
</BaseLayout>
