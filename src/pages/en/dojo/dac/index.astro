---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "●",
    name: "DAC Karate Club (DAC Motomachi Branch)",
    sub: "Instructor-dispatch class",
    address: "DAC Sports Club, Kita 20-jo Higashi 16-chome 1-2, Higashi-ku, Sapporo",
    schedule: ["Tuesday 16:00–"],
  },
];
---

<BaseLayout
  title="Karate Classes at the DAC Motomachi Branch, Higashi Ward"
  description="Introducing the Seishinkai DAC Motomachi Branch karate class, held at DAC Sports Club in Kita 20-jo, Higashi Ward, Sapporo. A Kids & Junior class held on Tuesdays."
  lang="en"
  path="/en/dojo/dac/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation — DAC Motomachi Branch</h1>
      </div>

      <p class="detail-page__lead">
        [DAC Sports Karate Class, Higashi Ward, Seishinkai DAC Branch]<br />
        A Kids and Junior karate class held at DAC Sports Club.<br />
        Active since October 2008 (Heisei 20).<br />
        We are currently recruiting members for the Kids and Junior classes.<br />
        While many dojos feel like an extension of school sports clubs, we aim to make karate an enjoyable, club-like experience centered on health and fitness.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※The DAC Karate Club is operated by DAC Sports Club, so trial lessons are paid (please pay directly at the venue). This class is hosted by DAC Sports Club.<br />
        For questions about the venue, please contact the <a
          href="mailto:karate@seishinkan.ne.jp?subject=DAC Trial Application"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/dac/Image1.jpg"
            alt="Practice session at the DAC Motomachi Branch"
            width="231"
            height="134"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/muro.jpg"
            alt="Muroki"
            width="102"
            height="102"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/dac/img2.jpg"
            alt="DAC Sports Club"
            width="117"
            height="65"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Higashi Ward — DAC Branch</h2>
      <p>
        ◆ Founded: October 2008 (Heisei 20)<br />
        ◆ Person in Charge: Takushi Muroki
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/パーソナルトレーニングジム+ダック/@43.088374,141.373362,15z/data=!4m5!3m4!1s0x0:0x198f5c6210f706a6!8m2!3d43.088374!4d141.373362"
          target="_blank"
          rel="noopener">DAC Sports Club, Kita 20-jo Higashi 16-chome 1-2, Higashi-ku, Sapporo</a
        ><br />
        〒065-0020 DAC Bldg. 3F, Kita 20-jo Higashi 16-chome 1-2, Higashi-ku, Sapporo　TEL 011-398-4842
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/パーソナルトレーニングジム+ダック/@43.088374,141.373362,15z/data=!4m5!3m4!1s0x0:0x198f5c6210f706a6!8m2!3d43.088374!4d141.373362"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/dac/2.jpg"
            alt="DAC Sports Club"
            width="208"
            height="201"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/higashi/">← Back to the Higashi Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
