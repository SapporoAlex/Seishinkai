---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Fushiko Karate Club",
    address: "Fushiko Memorial Hall, Fushiko 7-jo 2-chome 8-15, Higashi-ku, Sapporo",
    schedule: ["Saturday 9:30-10:00 (beginners' basics)", "10:00-10:50 (6th kyu and below)", "11:00-11:50 (5th kyu and above)"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Fushiko Branch, Higashi Ward"
  description="Introducing the Fushiko Karate Club, a Seishinkai Karate dojo in Fushiko, Higashi Ward, Sapporo. Training is held on Saturdays at the Fushiko Memorial Hall."
  lang="en"
  path="/en/dojo/fushiko/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation — Fushiko Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Fushiko Karate Class, Seishinkai Fushiko Branch, Higashi Ward]<br />
        The Fushiko Karate Class began in November 2011 (Heisei 23) at the Fushiko Memorial Hall.<br />
        It is a karate club centered on Kids Karate, the Junior Class, and Parent-Child Karate.<br />
        We especially welcome participation from parents and children together, and from the Senior Class.<br />
        While many dojos feel like an extension of school sports clubs, we aim to make karate an enjoyable, club-like experience centered on health and fitness.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※Since the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Fushiko Trial Application"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/fushiko/Image1.jpg"
            alt="Practice session at the Fushiko Branch"
            width="324"
            height="190"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/tuba.jpg"
            alt="Instructor Tsubasa Okubo"
            width="108"
            height="105"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Seishinkai Higashi Ward — Fushiko Branch / Fushiko Karate Club</h2>
      <p>
        ◆ Founded: November 2011 (Heisei 23)<br />
        ◆ Instructor: Tsubasa Okubo (2011–)
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒007-0867+北海道札幌市東区伏古７条２丁目８−１５+伏古記念会館/@43.090063,141.3897776,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2ecb7cb8d6fb:0x18450b6d1f6a09e1!8m2!3d43.090063!4d141.3919663"
          target="_blank"
          rel="noopener">Fushiko Memorial Hall, Fushiko 7-jo 2-chome 8-15, Higashi-ku, Sapporo</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/〒007-0867+北海道札幌市東区伏古７条２丁目８−１５+伏古記念会館/@43.090063,141.3897776,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2ecb7cb8d6fb:0x18450b6d1f6a09e1!8m2!3d43.090063!4d141.3919663"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/fushiko/2.jpg"
            alt="Fushiko Memorial Hall"
            width="277"
            height="210"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Fushiko Trial Application">
          <img
            src="/assets/images/legacy/dojo/fushiko/imgA.jpg"
            alt="Click here to apply for a trial lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/higashi/">← Back to the Higashi Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
