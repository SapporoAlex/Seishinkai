---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Sakaemachi Karate Club",
    address: "Sanai Jidosha Building, 3F Meeting Room, Kita 42 Higashi 19-chome, Higashi-ku",
    schedule: ["Sunday 9:30–10:30", "Extended class 10:30–11:00"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Higashi-ku Sakaemachi Branch"
  description="An introduction to the Sakaemachi Karate Club, a Seishinkai Karate-do dojo located at Kita 42-jo in Higashi-ku, Sapporo. Sunday practice sessions are held in the meeting room of the Sanai Jidosha Building."
  lang="en"
  path="/en/dojo/sakaemachi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation – Sakaemachi Branch</h1>
      </div>

      <h2 class="detail-page__heading">Higashi-ku Sakaemachi Karate Class – Seishinkai Sakaemachi Branch</h2>

      <p class="detail-page__lead">
        The Sakaemachi Karate Class started in September 2003, using a meeting room kindly
        lent by Sanai Jidosha Kogyo. It is a karate club centered on kids' karate, junior
        karate, and parent-and-child karate. We especially welcome participation from
        parents and children together, as well as senior members. While many dojos feel
        like an extension of a school sports club, we aim to make training feel more like
        a relaxed circle activity — enjoying karate as a way to build health and fitness
        while still learning its true spirit.
      </p>

      <div class="detail-page__highlight-box">
        <p class="detail-page__highlight-text">
          Seishinkai Karate: cultivating a spirit that never gives up and never breaks
        </p>
      </div>

      <BranchTable entries={entries} />

      {/* instructors={[
        { src: "/assets/images/instructors/namikawa.jpg", alt: "Instructor Namikawa", name: "Namikawa" }
      ]} */}
      <BranchInfoCard
        name="Higashi-ku Sakaemachi Branch"
        facts={[
          { label: "Founded", value: "September 2003" },
          { label: "Founders", value: "Kayoko Mimura, Kazuaki Namikawa" },
          { label: "Past Instructors", value: "Hashini" },
          { label: "Contact", value: "Headquarters-run" },
        ]}
        image={{
          src: "/assets/images/dojo/img_sakaemachi_bld.jpg",
          alt: "Practice session at the Sakaemachi Branch",
          width: 240,
          height: 168,
        }}
        address="Sanai Jidosha, Kita 42 Higashi 19-chome 1-1, Higashi-ku, Sapporo"
        mapHref="http://yahoo.jp/JbqUqo"
        mapQuery="Sanai Jidosha, Kita 42 Higashi 19-chome 1-1, Higashi-ku, Sapporo"
        viewOnMapLabel="View on Google Maps"
      />

      <p class="detail-page__note">
        *Part 1 (beginners / elementary school students): 9:30–10:30. Extended class
        (intermediate level and above): Part 1 + 10:30–11:00.
      </p>

      <p class="detail-page__note">
        *Preschool-age children must attend with a parent.
      </p>

      <h2 class="detail-page__heading">Access</h2>
      <div class="detail-page__img-text-pair">
        <div class="u-col u-w-full u-jc-start u-ai-center u-col-reverse">
          <div class="detail-media--med u-w-half">
            <figure>
              <a href="https://www.san-ai-jikou.co.jp/" target="_blank">
                <img
                  src="/assets/images/dojo/img_sanaijidosha.png"
                  alt="Sanai Jidosha logo"
                  width="300"
                  height="115"
                  loading="lazy"
                />
                </a>
            </figure>
          </div>
          <p class="detail-page__note u-mt-40">
            This venue is provided courtesy of Sanai Jidosha. Please ask an instructor
          where to park, and please do not enter any areas other than the training
          room.
          </p>
        </div>
        <div class="detail-media--bigger">
          <figure>
            <img
              src="/assets/images/dojo/img_sakaemachi-map_02.png"
              alt="After entering through the entrance, please go up the stairs. We are using the training room on the third floor, provided by San-ai Motor. Entry to areas other than the training room is prohibited."
              width="282"
              height="180"
              loading="lazy"
            />
          </figure>
        </div>
      </div>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_sakaemachi_01.jpg"
            alt="Seishinkai Sakaemachi Branch practice session"
            width="282"
            height="180"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_sakaemachi_02.jpg"
            alt="Seishinkai Sakaemachi Branch practice session"
            width="282"
            height="180"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_sakaemachi_03.jpg"
            alt="Seishinkai Sakaemachi Branch practice session"
            width="282"
            height="180"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_sakaemachi_04.jpg"
            alt="Seishinkai Sakaemachi Branch practice session"
            width="282"
            height="180"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/higashi/">← Back to the list of Higashi-ku dojos and classes</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Sakaemachi Branch"
        subject="Sakaemachi Trial Class Inquiry"
      />
    </div>
  </section>
</BaseLayout>