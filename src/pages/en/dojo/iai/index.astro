---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Iaido Division",
    address: "Seishinkan Headquarters Dojo",
    schedule: ["Sunday 14:00–15:00", "※Autumn/Winter/Spring hours; evening start possible in summer"],
  },
];

const videos = [
  {
    href: "https://www.youtube.com/playlist?list=PLyugCVja4s7Kz8vG3OA4GyMEpSKcsDzQV",
    image: "/assets/images/legacy/dojo/iai/img6.jpg",
    caption: "Performance Video",
  },
  {
    href: "https://www.youtube.com/playlist?list=PLyugCVja4s7Kz8vG3OA4GyMEpSKcsDzQV",
    image: "/assets/images/legacy/dojo/iai/img4.jpg",
    caption: "Early Members of the Seishinkai Iaido Division",
  },
  {
    href: "https://www.youtube.com/channel/UClIx3Srenlu1ddf5coow83A",
    image: "/assets/images/legacy/dojo/iai/img3.jpg",
    caption: "Taku Muroki's Channel",
  },
];
---

<BaseLayout
  title="Iaido Division"
  description="Introducing the Seishinkai Iaido Division, an iaido (sword-drawing) class in Sapporo. We practice on Sundays at the Seishinkan Headquarters Dojo and welcome members from junior high school students to seniors."
  lang="en"
  path="/en/dojo/iai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">IAIDO</span>
        <h1 class="section-title">Seishinkai Iaido Division</h1>
      </div>

      <p class="detail-page__lead">
        [Seishinkai Iaido Division]<br />
        The Seishinkai Iaido Division got its start in 2005 (Heisei 17), led by Maekawa Shihan, Muroki Shihan, and the late Mimura Kayoko Shihan, at the Shiroishi Seishinkan Dojo.<br />
        Today we practice at the Seishinkan Headquarters Dojo. About half of our members are women.<br />
        We are currently welcoming new members.<br />
        Seniors aged 60 and over are especially welcome!!<br />
        Members currently range from <strong>junior high school students to 84 years old</strong>
      </p>

      <h2 class="detail-page__heading">A Lifelong Hobby</h2>
      <p>
        <a href="http://karate15.dokkin.com/" target="_blank" rel="noopener"
          >Sundays from 14:00</a
        ><br />
        ※Autumn/Winter/Spring hours<br />
        During the height of summer heat, sessions may begin in the evening instead<br />
        Opening times may be delayed due to traffic conditions, so please wait if this happens.<br />
        Trial classes are available for 1,000 yen. We also offer one-time private seminars (tuition: 5,000–10,000 yen).
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Division", "Address / Venue", "Training Days"]}
      />

      <BranchInfoCard
        name="Seishinkai Iaido Division"
        facts={[
          { label: "Founded", value: "July 2005 (Heisei 17)" },
          { label: "Founder", value: "Nobutaka Maekawa (1st Division Head)" },
          { label: "Current Head", value: "Taku Muroki (2nd Division Head)" },
          {
            label: "Fees",
            value: [
              "Enrollment fee ¥7,000",
              "Annual fee ¥5,800",
              "Base monthly fee ¥6,000/month",
              "※¥3,000/month for current Karate Division members",
            ],
          },
        ]}
        image={{
          src: "/assets/images/dojo/img_iai_01.png",
          alt: "Seishinkan Headquarters Dojo",
          width: 263,
          height: 263,
        }}
        address="2-1-27 Sakaedori, Shiroishi-ku, Sapporo (along Tohoku-dori) — Seishinkan Headquarters Dojo"
        addressNote="About 10 min / 800m on foot from Shiroishi Subway Station"
        mapHref="https://www.google.com/maps/place/〒003-0021+北海道札幌市白石区栄通２丁目１−２７/@43.0409785,141.3938016,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b2bb4690b9e5f:0x622b301003410409!8m2!3d43.0409785!4d141.3959903"
        mapQuery="43.0409785,141.3938016"
        viewOnMapLabel="View on Google Maps"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/iai/img2.jpg"
            alt="An iaido practice session"
            width="322"
            height="171"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/iai/img7.jpg"
            alt="Seishinkai Iaido Division practice session"
            width="626"
            height="218"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        Please ask us about this when you come for a trial class<br />
        ※Fees are reduced in stages as you advance in rank<br />
        ※You will also need a hakama, iai gi, iai belt, iaito (sword), bokuto
        (wooden sword), soft sword, and other equipment.
      </p>

      <section class="partner-section">
        <h2 class="detail-page__heading">Watch Us on YouTube</h2>

        <div class="youtube-grid">
          {
            videos.map((video) => (
              <a
                class="youtube-card"
                href={video.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="youtube-card__thumb">
                  <img src={video.image} alt={`${video.caption} (YouTube)`} loading="lazy" />
                </span>
                <span>{video.caption}</span>
              </a>
            ))
          }
        </div>
      </section>

      <p class="detail-page__back">
        <a href="/en/dojo/">← Back to the Dojo & Class List</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Iaido Division"
        subject="Iaido Division Trial Lesson Application"
        directEmail="muroki-taku@seishinryu.info"
        directEmailLabel="Iaido Division Direct Email"
      />
    </div>
  </section>
</BaseLayout>
