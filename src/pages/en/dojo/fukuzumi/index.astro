---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Fukuzumi Branch",
    address: "5-5 Fukuzumi 1-jo 1-chome, Fukuzumi Children's Hall",
    schedule: ["Wednesday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Fukuzumi Branch, Toyohira Ward"
  description="Introducing the Seishinkai Karate dojo and class in Fukuzumi, Toyohira Ward, Sapporo. A junior-centered karate club — see training days and venue information."
  lang="en"
  path="/en/dojo/fukuzumi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Fukuzumi Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Toyohira Ward Fukuzumi Karate Club - Seishinkai Fukuzumi Branch]<br />
        The Fukuzumi karate class got its start in September 2010 (Heisei 22), borrowing space at the Fukuzumi Children's Hall.<br />
        Since its founding, the class has centered on Junior Karate, with members ranging from preschoolers to junior high schoolers.<br />
        Participation by parents and children together, as well as senior class members, is also welcome.<br />
        While many dojos feel like an extension of a school sports club, this one aims to offer karate for health and fitness that members can enjoy learning in a relaxed, club-like atmosphere.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Fukuzumi Trial Lesson Application"
          >office</a
        >.<br />
        Temporary venue: Arcs Tsukisamu-higashi, 1-30 Tsukisamu-higashi 3-jo 8-chome
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/fukuzumi/acs1.jpg"
            alt="Training session at the Fukuzumi Branch"
            width="308"
            height="189"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/sugimoto.jpg"
            alt="Instructor Sugimoto"
            width="107"
            height="110"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/ooba.jpg"
            alt="Ooba"
            width="106"
            height="106"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Fukuzumi Branch / Fukuzumi Karate Club</h2>
      <p>
        ◆Founded: September 2010 (Heisei 22)<br />
        ◆Past instructors: Furin (2010-2018)<br />
        　　　　Muroki (2018-2021)<br />
        　　　　Shima (2021-2024)<br />
        ◆Instructor: Sugimoto (2024-)
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/福住児童会館/@43.020565,141.402402,15z/data=!4m5!3m4!1s0x0:0x749365fd7c50d1bf!8m2!3d43.020565!4d141.402402"
          target="_blank"
          rel="noopener">5-5 Fukuzumi 1-jo 1-chome, Toyohira-ku, Sapporo, Fukuzumi Children's Hall</a
        >
      </p>
      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/fukuzumi/2.jpg"
          alt="Fukuzumi Children's Hall"
          width="262"
          height="174"
          loading="lazy"
        />
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Fukuzumi Trial Lesson Application">
          <img
            src="/assets/images/legacy/dojo/fukuzumi/img8.jpg"
            alt="Apply for a trial lesson here"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/toyohira/">← Back to the Toyohira Ward dojo & class list</a>
      </p>
    </div>
  </section>
</BaseLayout>
