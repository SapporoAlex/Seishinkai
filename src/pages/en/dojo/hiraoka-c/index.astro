---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Kiyota-ku Hiraoka Karate Class (Seishinkai Hiraoka Branch)",
    address: "5-jo 1-chome 1-40 Hiraoka, Kiyota-ku, Sapporo, Clubhouse Plaz",
    schedule: ["Tuesday 4:00-5:00 PM", "Thursday 7:00-8:00 PM"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Kiyota-ku Hiraoka Branch (Clubhouse Plaz Venue)"
  description="Introducing the Seishinkai karate class at Clubhouse Plaz in Hiraoka, Kiyota-ku, Sapporo. A junior-focused karate class, with training days and venue information."
  lang="en"
  path="/en/dojo/hiraoka-c/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Hiraoka Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Kiyota-ku Hiraoka Karate Class - Seishinkai Hiraoka Branch]<br />
        The Thursday class began at the Hiraoka Children's Hall in March 2010 (Heisei 22), and the Tuesday class started at the request of the neighborhood association at the neighborhood hall in September 2016 (Heisei 28), later moving to its current venue, Clubhouse Plaz.<br />
        The two classes were held at two separate venues, but in April 2020 (Reiwa 2), with the venues close by and the children's hall closing to outside groups due to the COVID-19 situation, the Thursday class was also moved to Plaz, so the two now operate from the same venue on different days.<br />
        Both days are centered on the junior class, but the Tuesday session is held a little earlier to make it easier for preschoolers and young elementary schoolers to attend.<br />
        Participation by parents and children together, and by senior members, is especially welcome.<br />
        While many dojos feel like an extension of school sports clubs, we aim for members to practice and learn in a relaxed, club-like atmosphere as health-oriented, physical-education-style karate.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Hiraoka Trial Lesson Inquiry"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/hiraoka-c/Image1.jpg"
            alt="Hiraoka Branch - Tuesday class practice"
            width="247"
            height="149"
            loading="lazy"
          />
          <figcaption>Tuesday class practice session</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/hiraoka-c/1.jpg"
            alt="Hiraoka Branch - Thursday class practice"
            width="245"
            height="134"
            loading="lazy"
          />
          <figcaption>Thursday class practice session</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">Kiyota-ku Hiraoka Branch</h2>
      <p>
        ◆Founded: March 2010 (Heisei 22) (Thursday class)<br />
        　　　　September 2016 (Heisei 28) (Tuesday class)<br />
        ◆Founder: Tsubasa Okubo<br />
        ◆Lead instructors: Shima, Wakabayashi, Sato<br />
        ■Directly run by Headquarters / instructors rotate
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/clubu/maekawa2.jpg"
            alt="Instructor Maekawa"
            width="103"
            height="103"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/wakabayashi.jpg"
            alt="Instructor Wakabayashi"
            width="105"
            height="105"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/sato2.jpg"
            alt="Instructor Sato"
            width="107"
            height="99"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/noro.jpg"
            alt="Instructor Noro"
            width="101"
            height="101"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/〒004-0875+北海道札幌市清田区平岡５条１丁目１−４０+クラブハウスプラッツ/@43.0087955,141.4478467,18z/data=!3m1!4b1!4m6!3m5!1s0x5f0b2b2be2f705a1:0xd912bff6f45f6a74!8m2!3d43.0087937!4d141.4490619!16s/g/12hpr3l9l?entry=ttu"
          target="_blank"
          rel="noopener">5-jo 1-chome 1-40 Hiraoka, Kiyota-ku, Sapporo, Clubhouse Plaz</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/〒004-0875+北海道札幌市清田区平岡５条１丁目１−４０+クラブハウスプラッツ/@43.0087955,141.4478467,18z/data=!3m1!4b1!4m6!3m5!1s0x5f0b2b2be2f705a1:0xd912bff6f45f6a74!8m2!3d43.0087937!4d141.4490619!16s/g/12hpr3l9l?entry=ttu"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/hiraoka-c/img3.jpg"
            alt="Clubhouse Plaz"
            width="266"
            height="155"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Hiraoka Trial Lesson Inquiry">
          <img
            src="/assets/images/legacy/dojo/hiraoka-c/img1A.jpg"
            alt="Click here to apply for a trial lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the Kiyota Ward & Minami Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
