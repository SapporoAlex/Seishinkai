---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import ClassScheduleCard from "@components/ClassScheduleCard.astro";

const entries = [
  {
    marker: "★",
    name: "Seishinkan Hondori Dojo",
    address: "12-41 Hondori 16-kita, Shiroishi-ku (along National Route 12)",
    schedule: [
      "Wednesday Class 4:30–5:30 PM",
      "Friday Class 7:00–8:00 PM",
      "Special Sunday Class (Now Accepting New Students – Begins Once 3 Students Enroll)",
    ],
  },
];

const classes = [
  {
    title: "Wednesday Class",
    schedule: ["4:30–5:30 PM"],
    instructors: [
      {
        name: "Rui",
        position: "Live-in Disciple",
        image: "/assets/images/instructors/rui.jpg",
      },
      {
        name: "Takashima",
        position: "Assistant Instructor",
        image: "/assets/images/instructors/takashima.jpg",
      },
    ],
  },
  {
    title: "Friday Class",
    schedule: ["7:00–8:00 PM"],
    instructors: [
      {
        name: "Keiji Wakabayashi",
        position: "Chief Instructor",
        image: "/assets/images/instructors/wakabayashi.jpg",
      },
    ],
  },
  {
    title: "Special Sunday Class",
    schedule: ["Now Accepting New Students / Begins Once 3 Students Enroll"],
    instructors: [
      {
        name: "Takashima",
        position: "Assistant Instructor",
        image: "/assets/images/instructors/takashima.jpg",
      },
    ],
  },
];
---

<BaseLayout
  title="Hondori Branch Karate Classes"
  description="Information about Seishinkan Hondori Dojo in Hondori, Shiroishi Ward, Sapporo. View class schedules and venue information."
  lang="en"
  path="/en/dojo/hondori/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation – Hondori Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Hondori Karate Class – Seishinkan Hondori Dojo]<br />
        The Hondori Karate Class has been operating at Seishinkan Hondori Dojo,
        located along National Route 12, since September 2011.<br />
        The dojo is easy to find, located next to Tokuju Yakiniku Restaurant and
        across from Round One.<br />
        Since its establishment, the dojo has focused primarily on children's and
        junior karate classes, while also welcoming parents and children who wish
        to train together.<br />
        As this is a dedicated dojo with limited space, each class is limited to
        15 students.<br />
        The dojo is fully air-conditioned.<br />
        Rather than the atmosphere of a traditional competitive sports club, we
        aim to provide a friendly environment where students can enjoy learning
        karate for health, fitness, and personal development.
      </p>

      <BranchTable entries={entries} />

      <p class="detail-page__note">
        Please contact the
        <a href="mailto:karate@seishinkan.ne.jp?subject=Hondori Branch Trial Lesson">
          Seishinkai Office
        </a>
        before attending a trial lesson.<br />
        Class starting times may occasionally vary, so please confirm your visit
        in advance.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_hondori_05.jpg"
            alt="Entrance to Hondori Seishinkan"
            width="234"
            height="144"
            loading="lazy"
          />
          <figcaption>
            Please remove your shoes at the entrance. Open the front door and
            proceed downstairs. The dojo is located in the basement.
          </figcaption>
        </figure>

        <figure>
          <img
            src="/assets/images/dojo/img_hondori_01.jpg"
            alt="Interior of Hondori Seishinkan"
            width="234"
            height="144"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/dojo/img_hondori_02.jpg"
            alt="Interior of Hondori Seishinkan"
            width="253"
            height="144"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/legacy/dojo/hondori/2.jpg"
            alt="Exterior of Hondori Seishinkan"
            width="234"
            height="144"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/legacy/dojo/hondori/img5.jpg"
            alt="Hondori Seishinkan (next to Tokuju Yakiniku)"
            width="253"
            height="144"
            loading="lazy"
          />
          <figcaption>Located next to Tokuju Yakiniku.</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">Seishinkan Hondori Dojo</h2>

      <p>
        ◆Established: April 2011<br />
        ◆Founder: Kayoko Mimura<br />
        ◆Former Instructors: Hashini, Yuka Takigami, Takashima, Masuda<br />
        ◆Current Instructors: Wakabayashi, Rui<br />
        *Adult black belt members also participate in instruction on an
        occasional basis.
      </p>

      <h2 class="detail-page__heading">Venue</h2>

      <p>
        <a
          href="https://www.google.com/maps/place/〒003-0027+北海道札幌市白石区本通１６丁目北１２&#8722;４１+キッズ空手教室本通清心館/@43.0360142,141.4332405,19.5z/data=!4m12!1m6!3m5!1s0x5f0b2b0b17d719c7:0x9df984ff883e2c96!2z44OR44OG44Kj44K544Oq44O844OV44Os44O844Or!8m2!3d43.035898!4d141.4338263!3m4!1s0x5f0b2b0b18c518bb:0xad01d582492e34fe!8m2!3d43.036098!4d141.4332991"
          target="_blank"
          rel="noopener"
        >
          Hondori Seishinkan<br />
          12-41 Hondori 16-kita, Shiroishi-ku, Sapporo
          (along National Route 12)
        </a><br />
        Approximately 11 minutes on foot (850 m) from Exit 2 of Nango 18-chome
        Subway Station.<br />
        3 minutes on foot from the JR Bus stop "Shimo-Shiroishi," or 2 minutes
        from the Chuo Bus stop "Hondori 16-chome."
      </p>

      <p class="detail-page__note">
        Parking is not available at the dojo. Please use a nearby paid parking
        lot. A Mitsui no Repark parking lot is located across from the Round One
        outdoor parking area, approximately 140 m (2 minutes on foot) from the
        dojo.
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Hondori Branch Trial Lesson">
          <img
            src="/assets/images/legacy/dojo/hondori/img1E.jpg"
            alt="Apply for a Trial Lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/shiroishi/">← Back to the Shiroishi Ward Dojo List</a>
      </p>
    </div>
  </section>
</BaseLayout>