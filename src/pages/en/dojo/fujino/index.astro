---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "#",
    name: "Minami-ku Fujino Karate Class (Seishinkai Fujino Branch)",
    sub: "Fujino Karate Club",
    address: "2-jo 7-chome 2-1 Fujino, Minami-ku, Sapporo, Fujino District Center",
    schedule: ["Saturday 10:00-11:00 AM"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Fujino Branch"
  description="Introducing the Seishinkai karate class at the Fujino District Center in Minami-ku, Sapporo. Focused on kids and junior karate, with training days and venue information."
  lang="en"
  path="/en/dojo/fujino/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Fujino Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Minami-ku Fujino Karate Class - Seishinkai Fujino Branch]<br />
        The Fujino Karate Class has been operating since March 2011 (Heisei 23), using the Fujino District Center as its venue.<br />
        As a kids' and junior karate class, we would like to focus mainly on children from preschool age through junior high school. We are currently recruiting trial students!<br />
        Participation by parents and children together, and by senior members, is also welcome.<br />
        While many dojos feel like an extension of school sports clubs, we aim for members to practice and learn in a relaxed, club-like atmosphere as health-oriented, physical-education-style karate.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Fujino Trial Lesson / Enrollment Inquiry"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/fujino/acs1.jpg"
            alt="Fujino Branch practice session"
            width="319"
            height="205"
            loading="lazy"
          />
        </figure>
      </div>

      <BranchInfoCard
        name="Seishinkai Fujino Branch / Fujino Karate Club"
        facts={[
          { label: "Founded", value: "March 2011 (Heisei 23)" },
          { label: "Founder", value: "Yusuke Koyano" },
          { label: "Past instructors", value: "Hashini, Takashima, Hyodo" },
          { label: "Instructor", value: "Okimura (2022-), plus adult black belt members joining occasionally" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/fujino/2.jpg",
          alt: "Fujino District Center",
          width: 243,
          height: 192,
        }}
        instructors={[
          { src: "/assets/images/instructors/okimura.jpg", alt: "Instructor Okimura", name: "Okimura" },
        ]}
        address="2-jo 7-chome 2-1 Fujino, Minami-ku, Sapporo, Fujino District Center"
        mapHref="https://www.google.com/maps/place/〒061-2282+北海道札幌市南区藤野２条７丁目２−１+札幌市藤野地区センター/data=!4m2!3m1!1s0x5f0ad4a1fe1a011b:0xa26126fd6c360ffa?sa=X&ved=2ahUKEwi_mrjHjrHhAhXHG6YKHZu7AM0Q8gEwAHoECAoQAQ"
        mapQuery="2-jo 7-chome 2-1 Fujino, Minami-ku, Sapporo, Fujino District Center"
      />

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Fujino Trial Lesson / Enrollment Inquiry">
          <img
            src="/assets/images/legacy/images/Image2.jpg"
            alt="Click here to apply for a trial lesson"
            width="645"
            height="260"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the Kiyota Ward & Minami Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
