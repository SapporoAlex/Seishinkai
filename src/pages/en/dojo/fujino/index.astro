---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "Minami-ku Fujino Karate Class (Seishinkan Fujino Branch)",
    sub: "Fujino Karate Club",
    address: "Fujino District Center, Fujino 2-jo 7-chome 2-1, Minami-ku, Sapporo",
    schedule: ["Saturday 10:00–11:00"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Fujino Branch"
  description="An introduction to the Seishinkan karate class at the Fujino District Center in Minami-ku, Sapporo. Centered on kids' and junior karate, with class days and venue information."
  lang="en"
  path="/en/dojo/fujino/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkan Karate-do Federation – Fujino Branch</h1>
      </div>
      <h2 class="detail-page__heading">Minami-ku Fujino Karate Class – Seishinkan Fujino Branch</h2>
      <p class="detail-page__lead">
        The Fujino Karate Class has been active since March 2011, using space kindly
        lent by the Fujino District Center.<br />
        We aim to focus on kids' and junior karate, welcoming participants from
        preschool age through junior high school.
        <span class="u-color-red u-bold">We are currently accepting trial participants!</span><br />
        We also welcome participation from parents and children together, as well as
        senior members.<br />
        While many dojos feel like an extension of a school sports club, we aim to
        make training feel more like a relaxed circle activity — enjoying karate as a
        way to build health and fitness while still learning its true spirit.
      </p>

      <div class="detail-page__highlight-box">
        <p class="detail-page__highlight-text">
          Seishinkan Karate: cultivating a spirit that never gives up and never breaks
        </p>
      </div>

      <BranchTable entries={entries} />

      <BranchInfoCard
        name="Minami-ku Fujino Branch / Fujino Karate Club"
        facts={[
          { label: "Founded", value: "March 2011" },
          { label: "Founder", value: "Yusuke Koyano" },
          { label: "Past Instructors", value: "Hashini, Takashima, Hyodo" },
          { label: "Contact", value: "Okimura (2022–)" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/fujino/2.jpg",
          alt: "Fujino District Center",
          width: 243,
          height: 192,
        }}
        instructors={[
          { src: "/assets/images/instructors/okimura.jpg", alt: "Instructor Okimura", name: "Okimura" },
        ]}
        address="Fujino District Center, Fujino 2-jo 7-chome 2-1, Minami-ku, Sapporo"
        mapHref="https://www.google.com/maps/place/〒061-2282+北海道札幌市南区藤野２条７丁目２−１+札幌市藤野地区センター/data=!4m2!3m1!1s0x5f0ad4a1fe1a011b:0xa26126fd6c360ffa?sa=X&ved=2ahUKEwi_mrjHjrHhAhXHG6YKHZu7AM0Q8gEwAHoECAoQAQ"
        mapQuery="Fujino District Center, Fujino 2-jo 7-chome 2-1, Minami-ku, Sapporo"
        viewOnMapLabel="View on Google Maps"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_fujino_01.jpg"
            alt="Practice session at the Fujino Branch"
            width="319"
            height="205"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/dojo/img_fujino_02.jpg"
            alt="Practice session at the Fujino Branch"
            width="319"
            height="205"
            loading="lazy"
          />
        </figure>

        <figure>
          <img
            src="/assets/images/legacy/dojo/fujino/acs1.jpg"
            alt="Practice session at the Fujino Branch"
            width="319"
            height="205"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        *Occasionally, black-belt members of the general adult class may join.
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the list of Kiyota-ku and Minami-ku dojos and classes</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Fujino Branch"
        subject="Fujino Trial Class / Enrollment Inquiry"
      />
    </div>
  </section>
</BaseLayout>