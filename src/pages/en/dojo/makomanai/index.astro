---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "#",
    name: "Minami-ku Makomanai Karate Class (Seishinkai Makomanai Branch)",
    sub: "Makomanai Karate Club",
    address: "2-2-1 Makomanai Sachimachi, Minami-ku, Sapporo, Minami-ku Community Center meeting room, etc.",
    schedule: ["Monday 6:30-7:30 PM"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Makomanai Branch"
  description="Introducing the Seishinkai karate class at the Minami-ku Community Center in Makomanai, Minami-ku, Sapporo. Focused on kids and junior karate, with training days and venue information."
  lang="en"
  path="/en/dojo/makomanai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Makomanai Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Minami-ku Makomanai Karate Class / Seishinkai Makomanai Branch]<br />
        The Makomanai karate class got its start in 2007 (Heisei 19) at the Makomanai Gorin Children's Hall. In 2017 (Heisei 29), with membership having declined, it merged with the Moiwa and Tokiwa branches, but it resumed independently in September 2019 (Reiwa 1).<br />
        Following the consolidation of local elementary schools, the children's hall closed, and from August 2026 (Reiwa 8) practice has been held at the Minami-ku Community Center meeting room.<br />
        We'd like to focus on Kids Karate and Junior Karate, centered on members from preschool age through junior high. We're currently looking for trial participants!<br />
        Parent-and-child participation is also more common here than at many of our other branches.<br />
        While many dojos feel like an extension of a school sports club, this one aims to offer karate for health and fitness that members can enjoy learning in a relaxed, club-like atmosphere.<br />
        ※ Depending on future school consolidations, we may move again if a better venue becomes available, including a new children's hall.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Makomanai Trial Lesson Inquiry"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/makomanai/acs1.jpg"
            alt="Makomanai Branch practice session"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <BranchInfoCard
        name="Seishinkai Makomanai Branch / Makomanai Karate Club"
        facts={[
          { label: "Founded", value: "April 2007 (Heisei 19) (~2017)" },
          { label: "Founder", value: "Takushi Muroki" },
          { label: "Reopened", value: "September 2019 (Reiwa 1)" },
          { label: "Instructor", value: "Okimura, plus adult black belt members joining occasionally" },
        ]}
        instructors={[
          { src: "/assets/images/instructors/oki.jpg", alt: "Instructor Okimura", name: "Okimura" },
        ]}
        address="2-2-1 Makomanai Sachimachi, Minami-ku, Sapporo — Minami-ku Community Center meeting room, etc."
      />

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Makomanai Trial Lesson Inquiry">
          <img
            src="/assets/images/legacy/dojo/makomanai/img9.jpg"
            alt="Click here to apply for a trial lesson"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the Kiyota Ward & Minami Ward Dojo & Class List</a>
      </p>
    </div>
  </section>
</BaseLayout>
