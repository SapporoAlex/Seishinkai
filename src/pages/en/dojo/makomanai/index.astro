---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "Seishinkai Makomanai Branch",
    sub: "Makomanai Karate Club",
    address: "Makomanai Gorin Children’s Hall (Located on the grounds of Makomanai Gakuen) 3-13-1 Makomanai Izumimachi, Minami-ku, Sapporo, Hokkaido",
    schedule: ["Monday 18:30–19:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Makomanai Branch"
  description="An introduction to the Seishinkai karate class at the Minami-ku Citizens' Center in Makomanai, Minami-ku, Sapporo. Centered on kids' and junior karate, with class days and venue information."
  lang="en"
  path="/en/dojo/makomanai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation – Makomanai Branch</h1>
      </div>

      <h2 class="detail-page__heading">Minami-ku Makomanai Karate Class – Seishinkai Makomanai Branch</h2>

      <p class="detail-page__lead">
      The Makomanai Karate Class started in 2007 at the Makomanai Gorin Children's
      Center. In 2017, as membership declined, it merged with the Moiwa and Tokiwa
      branches, but it reopened in September 2019.
      Following the consolidation of local elementary schools, the Children's Center
      closed, and since August 2026 classes have been held in the meeting room of the
      Minami-ku Citizens' Center.
      We aim to focus on kids' and junior karate, welcoming participants from
      preschool age through junior high school.
      <span class="u-color-red u-bold">We are currently accepting trial participants!</span>
      </p>

        <div class="detail-page__highlight-box">
          <p class="detail-page__highlight-text">
            Seishinkai Karate: cultivating a spirit that never gives up and never breaks
          </p>
        </div>

      <BranchTable entries={entries} />

      {/* instructors={[
        { src: "/assets/images/instructors/okimura.jpg", alt: "Instructor Okimura", name: "Okimura" },
      ]} */}
      <BranchInfoCard
        name="Seishinkai Makomanai Branch / Makomanai Karate Club"
        facts={[
          { label: "Founded", value: "April 2007 (–2017)" },
          { label: "Founder", value: "Takushi Muroki" },
          { label: "Reopened", value: "September 2019" },
          { label: "Contact", value: "Headquarters-run" },
        ]}
        image={{
          src: "/assets/images/dojo/img_makomanai_bld.jpg",
          alt: "Makomanai Gorin Children’s Hall (Located on the grounds of Makomanai Gakuen) 3-13-1 Makomanai Izumimachi, Minami-ku, Sapporo, Hokkaido 005-0015, Japan",
          width: 299,
          height: 154,
        }}
        address="Makomanai Gorin Children’s Hall (Located on the grounds of Makomanai Gakuen) 3-13-1 Makomanai Izumimachi, Minami-ku, Sapporo",
        mapHref="https://www.google.com/maps/place/3-ch%C5%8Dme-13-1+Makomanaiizumimachi,+Minami+Ward,+Sapporo,+Hokkaido+005-0015/@42.984901,141.3559624,17z/data=!3m1!4b1!4m6!3m5!1s0x5f0ad53e60343645:0x87c2ba4e3f32a4f3!8m2!3d42.984901!4d141.3559624!16s%2Fg%2F11cpcgxp99?entry=ttu&g_ep=EgoyMDI2MDkyMC4wIKXMDSoASAFQAw%3D%3D"
        mapQuery="3-chōme-13-1 Makomanaiizumimachi, Minami Ward, Sapporo, Hokkaido 005-0015"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_01.jpg"
            alt="Practice session at the Makomanai Branch"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_02.jpg"
            alt="Practice session at the Makomanai Branch"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_03.jpg"
            alt="Practice session at the Makomanai Branch"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_makomanai_04.jpg"
            alt="Practice session at the Makomanai Branch"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
      *Occasionally, black-belt members of the general adult class may join.
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the list of Kiyota-ku and Minami-ku dojos and classes</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Makomanai Branch"
        subject="Makomanai Trial Class Inquiry"
      />
    </div>
  </section>
</BaseLayout>