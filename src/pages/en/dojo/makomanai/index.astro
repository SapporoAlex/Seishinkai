---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";

const entries = [
  {
    marker: "#",
    name: "Seishinkan Makomanai Branch",
    sub: "Makomanai Karate Club",
    address: "Minami-ku Citizens' Center Meeting Room, etc., Makomanai Sachimachi 2-chome 2-1, Minami-ku, Sapporo",
    schedule: ["Monday 18:30–19:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Minami-ku Makomanai Branch"
  description="An introduction to the Seishinkan karate class at the Minami-ku Citizens' Center in Makomanai, Minami-ku, Sapporo. Centered on kids' and junior karate, with class days and venue information."
  lang="en"
  path="/en/dojo/makomanai/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkan Karate-do Federation – Makomanai Branch</h1>
      </div>
      <h2 class="detail-page__heading">Minami-ku Makomanai Karate Class – Seishinkan Makomanai Branch</h2>
      <p class="detail-page__lead">
      The Makomanai Karate Class started in 2007 at the Makomanai Gorin Children's
      Center. In 2017, as membership declined, it merged with the Moiwa and Tokiwa
      branches, but it reopened in September 2019.
      Following the consolidation of local elementary schools, the Children's Center
      closed, and since August 2026 classes have been held in the meeting room of the
      Minami-ku Citizens' Center.
      We aim to focus on kids' and junior karate, welcoming participants from
      preschool age through junior high school.
      <span class="u-color-red u-bold">We are currently accepting trial participants!</span>
      </p>
      <p class="detail-page__lead">
      We also tend to have more parent-and-child participation than other branches.
      While many dojos feel like an extension of a school sports club, we aim to
      make training feel more like a relaxed circle activity — enjoying karate as a
      way to build health and fitness while still learning its true spirit.
      *Depending on further school consolidations, we may move from the current
      Citizens' Center to a new children's center or another suitable venue if one
      becomes available.
      </p>

        <div class="detail-page__highlight-box">
          <p class="detail-page__highlight-text">
            Seishinkan Karate: cultivating a spirit that never gives up and never breaks
          </p>
        </div>

      <BranchTable entries={entries} />

      <BranchInfoCard
        name="Seishinkan Makomanai Branch / Makomanai Karate Club"
        facts={[
          { label: "Founded", value: "April 2007 (–2017)" },
          { label: "Founder", value: "Takushi Muroki" },
          { label: "Reopened", value: "September 2019" },
          { label: "Contact", value: "Okimura" },
        ]}
        image={{
          src: "/assets/images/dojo/img_makomanai_01.jpg",
          alt: "Minami-ku Citizens' Center Meeting Room, etc., Makomanai Sachimachi 2-chome 2-1, Minami-ku, Sapporo",
          width: 299,
          height: 154,
        }}
        instructors={[
          { src: "/assets/images/instructors/okimura.jpg", alt: "Instructor Okimura", name: "Okimura" },
        ]}
        address="Minami-ku Citizens' Center Meeting Room, etc., Makomanai Sachimachi 2-chome 2-1, Minami-ku, Sapporo"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/makomanai/acs1.jpg"
            alt="Practice session at the Makomanai Branch"
            width="316"
            height="194"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
      *Occasionally, black-belt members of the general adult class may join.
      </p>

      <p class="detail-page__note">
        *As this venue is a rented facility, please direct inquiries to the
        <a href="mailto:karate@seishinkan.ne.jp?subject=Makomanai Trial Class Inquiry"
          >office</a
        >.
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Makomanai Trial Class Inquiry">
          <img
            src="/assets/images/legacy/dojo/makomanai/img9.jpg"
            alt="Click here to apply for a trial class"
            width="645"
            height="293"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/minami-kiyota/">← Back to the list of Kiyota-ku and Minami-ku dojos and classes</a>
      </p>
    </div>
  </section>
</BaseLayout>