---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "Seishinkan Oasa Dojo",
    sub: "(Ebetsu Area Headquarters Dojo)",
    address: "6-9 Oasa-sawacho, Ebetsu, Seishinkan, Park Hills 1F (along Niban-dori)",
    schedule: [
      "Monday 16:00",
      "Thursday 18:30",
      "Friday 16:00",
      "Friday 18:45 (reservation required)",
      "Saturday 10:00",
    ],
  },
];
---

<BaseLayout
  title="Karate Classes in Oasa, Ebetsu City — Seishinkan Oasa Dojo"
  description="Information on the Seishinkai karate dojo — Seishinkan Oasa Dojo — in Oasa, Ebetsu City. A permanent dojo on the 1st floor of Park Hills, offering multiple classes per week — details on schedule and venue."
  lang="en"
  path="/en/dojo/oasa/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Ebetsu Oasa Branch "Seishinkan Oasa"</h1>
      </div>

      <h2 class="detail-page__heading">Seishinkan Oasa Karate Class / Seishinkai Oasa Branch</h2>

      <p class="detail-page__lead">
        Seishinkan Oasa Karate Class is a permanent dojo established in April 2008 (Heisei 20), on the 1st floor of Park Hills along Niban-dori in Oasa, Ebetsu.<br />
        It started out focused mainly on the Junior Class; it currently runs twice a week, with preparations underway to add classes on additional days.<br />
        We especially welcome parent-child participants and members of our Senior Class.<br />
        While many dojos feel like an extension of school sports-club activities, we aim for karate as health and fitness training — practicing and learning together in a relaxed, club-like atmosphere.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <BranchInfoCard
        name="Oasa Branch, Ebetsu City / Oasa Karate Club"
        facts={[
          { label: "Founded", value: "April 2008 (Heisei 20)" },
          { label: "Instructors", value: "Headquarters-run" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/oasa/2.jpg",
          alt: "Seishinkan Oasa Karate Dojo",
          width: 342,
          height: 273,
        }}
        address="6 Oasa-sawacho, Ebetsu, Park Hills 1F Seishinkan Oasa Karate Dojo"
        addressNote="Located along Niban-dori, next to Oasa Nishi Park."
        mapHref="https://www.google.com/maps/dir/43.0720251,141.4873424/43.071927,141.48733/@43.071403,141.4865876,18.5z"
        mapQuery="43.071403,141.4865876"
      />

      <div class="detail-media">
        <img
          src="/assets/images/legacy/base/iqi.jpg"
          alt="Exterior of Park Hills"
          width="633"
          height="149"
          loading="lazy"
        />
      </div>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/oasa/Image1.jpg"
            alt="Monday Class practice session"
            width="284"
            height="141"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/oasa/Image2.jpg"
            alt="Friday Class practice session"
            width="286"
            height="133"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/oasa/img6.jpg"
            alt="Thursday Class practice session"
            width="325"
            height="148"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/oasa/Image3.jpg"
            alt="Full view of Seishinkan Oasa Dojo"
            width="307"
            height="205"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        ● Monday Class 16:00–17:00 (preschool – elementary school)<br />
        ● Friday Class 16:00–17:00 (preschool – elementary school)<br />
        ● Thursday Class 18:30–19:30 (elementary school – adult)<br />
        ★ Friday Evening Class — special limited class / reservation required — 18:45–20:00<br />
        ★ Saturday Class 10:00–11:00
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/ebetsu/">← Back to the list of dojos & classes in Ebetsu, Iwamizawa & Ishikari</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Ebetsu Oasa Branch (Seishinkan Oasa)"
        subject="Oasa Trial Lesson Application"
      />
    </div>
  </section>
</BaseLayout>
