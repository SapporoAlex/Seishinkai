---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Naganuma Karate Club",
    address: "Chuo-Minami 2-chome, Naganuma Town (Naganuma Sports Center)",
    schedule: ["Tuesday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes in Naganuma Town"
  description="Information on the Seishinkai Karate dojo — Naganuma Branch — in Naganuma Town, Hokkaido. Training days and venue details."
  lang="en"
  path="/en/dojo/naganuma/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Naganuma Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Naganuma Karate Class / Seishinkai Naganuma Branch]<br />
        The Naganuma Karate Class was started in August 2011 (Heisei 23) by a member living in Naganuma
        Town who had been commuting to the Kita-Hiroshima Branch, and who gathered fellow members to form
        the class.<br />
        The venue is the Naganuma Sports Center.<br />
        The class is centered on Kids and Junior classes. Parent-child participation and Senior Class members
        are also welcome.<br />
        While many dojos feel like an extension of school sports-club activities, we aim for karate as health
        and fitness training — practicing and learning together in a relaxed, club-like atmosphere.<br />
        ※For 3-year-old preschoolers attending with a parent, the monthly fee is free.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <p class="detail-page__note">
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Naganuma Trial Lesson Application"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/naganuma/Image1.jpg"
            alt="Naganuma Branch practice session"
            width="237"
            height="124"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/Image1.jpg"
            alt="Seishinkai Karate training session"
            width="649"
            height="196"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/shima.jpg"
            alt="Instructor Shima"
            width="1254"
            height="1254"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/taki.jpg"
            alt="Instructor Sakamoto"
            width="167"
            height="167"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Naganuma Branch</h2>
      <p>
        ◆ Founded: August 2011 (Heisei 23)<br />
        ◇ Founder: Akiko Furudate<br />
        ◆ Instructors in charge: Headquarters-run — Shima, Sakamoto
      </p>

      <p class="detail-page__note">
        ※As this is a headquarters-run class, multiple instructors rotate in on a shared basis.
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/長沼町スポーツセンター/@43.007859,141.69233,15z/data=!4m2!3m1!1s0x0:0xc6cede9b78bc4cf5"
          target="_blank"
          rel="noopener">Chuo-Minami 2-chome, Naganuma Town, Naganuma Sports Center</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps/place/長沼町スポーツセンター/@43.007859,141.69233,15z/data=!4m2!3m1!1s0x0:0xc6cede9b78bc4cf5"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/naganuma/2.jpg"
            alt="Naganuma Sports Center"
            width="200"
            height="131"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/tobetsu/">← Back to the Dojo List</a>
      </p>
    </div>
  </section>
</BaseLayout>
