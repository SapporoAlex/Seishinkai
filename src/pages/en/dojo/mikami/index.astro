---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Sapporo Chuo-Higashi Branch",
    address: "Mikami Bldg. 3F, Minami 2-jo Higashi 4-chome, Chuo-ku",
    schedule: ["Wednesday 18:30/19:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Chuo-Higashi Branch, Chuo Ward"
  description="Introducing the Sapporo Chuo-Higashi Branch (also known as the Kamome Branch) of Seishinkai Karate at Mikami Bldg. (Kamome Academy) in Chuo Ward, Sapporo. See training days and venue information."
  lang="en"
  path="/en/dojo/mikami/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation - Chuo-Higashi Branch</h1>
      </div>

      <h2 class="detail-page__heading">Sapporo Chuo-Higashi Karate Class - Seishinkai Chuo-Higashi Branch</h2>

      <p class="detail-page__lead">
        The Chuo-Higashi karate class, nicknamed the "Kamome Branch," was established in June 2015 (Heisei 27).<br />
        It offers both a Junior class and a General class (working adults and students); being located in Chuo Ward, it draws a well-balanced mix of adults and children.<br />
        With easy access near the subway Bus Center Station, many members attend on their way home from work for stress relief and general health.<br />
        We also hold self-defense seminars for women from time to time. Women make up 60% of our General class!<br />
        While many dojos feel like an extension of a school sports club, this one aims to offer karate for health and fitness that members can enjoy learning in a relaxed, club-like atmosphere.<br />
        ※International students and residents are welcome (English-speaking staff available)! We currently have members from Germany and the UK!
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <BranchInfoCard
        name="Chuo-Higashi Branch"
        facts={[
          { label: "Founded", value: "June 2015 (Heisei 27)" },
          { label: "Founder", value: "Jun Mikami" },
          { label: "Instructor", value: "Headquarters-run" },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/mikami/2.jpg",
          alt: "Mikami Bldg. (Kamome Academy)",
          width: 230,
          height: 203,
        }}
        address="1-10 Minami 2-jo Higashi 4-chome, Chuo-ku, Sapporo, Mikami Bldg. 3F"
        addressNote="About a 4-minute walk (300m) from the subway Bus Center Station. There is no on-site parking, so if driving please use a nearby paid parking lot."
        mapHref="https://www.google.com/maps/place/〒060-0052+北海道札幌市中央区南２条東４丁目１/@43.0593031,141.3601062,17z/data=!3m1!4b1!4m5!3m4!1s0x5f0b29788cad6f89:0xb8705edfef429a09!8m2!3d43.0593031!4d141.3622949"
        mapQuery="43.0593031,141.3601062"
      />

      <p class="detail-page__note">
        ◆Training days / Wednesdays 18:30–19:30 (Junior) / 19:30–20:30 (General)
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_01.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_02.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_03.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_04.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_05.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_chuouhigashi_06.jpg"
            alt="Training session at the Chuo-Higashi Branch"
            width="326"
            height="192"
            loading="lazy"
          />
        </figure>
      </div>



      <p class="detail-page__back">
        <a href="/en/dojo/cyuo/">← Back to the Chuo Ward dojo & class list</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Chuo-Higashi Branch"
        subject="Chuo-Higashi Branch Trial & Enrollment Inquiry"
      />
    </div>
  </section>
</BaseLayout>
