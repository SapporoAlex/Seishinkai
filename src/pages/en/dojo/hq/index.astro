    schedule: ["Saturday 3:30–4:30 PM"],
    instructors: [
      {
        name: "Shima",
        position: "Assistant Instructor",
        image: "/assets/images/instructors/shima.jpg",
      },
    ],
  },
  {
    title: "Kindergarten & Elementary Class (NEW!) / White Belt Class",
    schedule: ["Thursday 3:00–3:45 PM"],
    instructors: [
      {
        name: "Saori Okimura",
        position: "Assistant Instructor",
        image: "/assets/images/instructors/okimura.jpg",
      },
      {
        name: "Rui",
        position: "Live-in Student",
        image: "/assets/images/instructors/rui.jpg",
      },
    ],
  },
  {
    title: "Senior & Daytime Class",
    schedule: ["Monday & Wednesday 2:30–3:30 PM"],
    instructors: [
      {
