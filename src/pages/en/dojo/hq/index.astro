        position: "Assistant Instructor",
        image: "/assets/images/instructors/kimura.jpg",
      },
    ],
  },
  {
    title: "Special Class for Students Not Attending School",
    schedule: ["Tuesday 3:00 PM / 5:00 PM", "Thursday from 3:00 PM"],
    instructors: [
      {
        name: "Nobutaka Maekawa",
        position: "Instructor",
        image: "/assets/images/instructors/maekawa.jpg",
      },
    ],
  },
  {
    title: "Women's Class",
    schedule: ["Friday 6:30–7:30 PM"],
    instructors: [
      {
        name: "Asami Yamazaki",
        position: "Assistant Instructor",
        image: "/assets/images/instructors/asami.jpg",
      },
    ],
  },
  {
    title: "Adult Class (Students & Adults)",
    schedule: ["Wednesday 7:30–9:00 PM", "Saturday 7:00–9:00 PM"],
    instructors: [
      {
        name: "Tsubasa Okubo",
        position: "Chief Instructor",
        image: "/assets/images/instructors/tsubasa.jpg",
      },
      {
        name: "Masami Okubo",
        position: "Founder",
        image: "/assets/images/instructors/masami.jpg",
      },
    ],
