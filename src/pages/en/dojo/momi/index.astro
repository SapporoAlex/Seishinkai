---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Momijidai Branch",
    address: "Momijidai-kita 7-chome, Atsubetsu-ku, Sapporo — Momijidai Management Center",
    schedule: ["Saturday", "①10:00-10:55", "②11:00-11:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Momijidai Branch"
  description="Introducing the Seishinkai Karate dojo and classes in Momijidai, Atsubetsu-ku, Sapporo. Details on the Saturday class schedule and venue."
  lang="en"
  path="/en/dojo/momi/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Momijidai Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Momijidai Karate Class, Atsubetsu-ku / Seishinkai Momijidai Branch]<br />
        The Momijidai Karate Class began its activities at the Momijidai Management Center in April 2010 (Heisei 22).<br />
        Since its founding, it started as Kids Karate and Junior Karate, and now welcomes a wide range of participants, from preschoolers to adults (parent and child).<br />
        Parent-and-child participation is especially welcome.<br />
        While many dojos feel like an extension of school sports-club culture, we aim for karate as health and fitness — practiced and learned with the relaxed enjoyment of a community club.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <p class="detail-page__note">
        ※Training days are Saturday 10:00–10:55 and 11:00–11:30.<br />
        ※As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Momijidai Trial Lesson & Enrollment Inquiry"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_momi_01.jpg"
            alt="Practice session at the Momijidai Branch"
            width="287"
            height="123"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/momi/2.jpg"
            alt="Momijidai Management Center"
            width="330"
            height="213"
            loading="lazy"
          />
          <figcaption>Adjacent to the Momijidai Shopping Center</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/instructors/maekawa.jpg"
            alt=""
            width="106"
            height="106"
            loading="lazy"
          />
          <figcaption>Nobutaka Maekawa (occasional visiting instructor)</figcaption>
        </figure>
      </div>

      <h2 class="detail-page__heading">Momijidai Branch</h2>
      <p>
        ◆Founded: April 2010 (Heisei 22)<br />
        ◆In charge: Maekawa and other adult division dan-ranked members.
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps/place/もみじ台管理センター/@43.031883,141.491963,15z/data=!4m5!3m4!1s0x0:0x7df1cd1f8ac0d953!8m2!3d43.031883!4d141.491963"
          target="_blank"
          rel="noopener">Momijidai 7-chome 1-1, Atsubetsu-ku, Sapporo — Momijidai Management Center, Meeting Room</a
        >
      </p>

      <p class="detail-page__note">
        <a href="mailto:karate@seishinkan.ne.jp?subject=Momijidai Trial Lesson & Enrollment Inquiry">
          <img
            src="/assets/images/legacy/dojo/momi/imgA.jpg"
            alt="Click here for a trial lesson"
            width="645"
            height="271"
            loading="lazy"
          />
        </a>
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/atsubetsu/">← Back to Karate Dojos & Classes in Atsubetsu Ward</a>
      </p>
    </div>
  </section>
</BaseLayout>
