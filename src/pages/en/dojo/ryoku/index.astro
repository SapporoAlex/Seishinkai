---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "#",
    name: "Ishikari Karate Club",
    address: "Ryokuentai Higashi 2-jo 1-chome, Ishikari, Ryokuentai Green Hall",
    schedule: ["Saturday 15:30"],
  },
];
---

<BaseLayout
  title="Karate Classes in Ishikari City"
  description="Information on the Seishinkai karate dojo/class in Ishikari City. A karate club focused on Junior Karate and Parent-Child Karate, held at the Ryokuentai Green Hall — details on training days and venue."
  lang="en"
  path="/en/dojo/ryoku/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Ishikari Branch</h1>
      </div>

      <h2 class="detail-page__heading">Ishikari Karate Class / Seishinkai Ishikari Branch</h2>

      <p class="detail-page__lead">
        The Ishikari Karate Club was established in March 2018 as the Hanakawa Higashi / Ryokuen-dai Karate Club, with Ryokuen-dai Green Kaikan serving as its training venue.
        In August 2026, it merged with the Hanakawa Branch in Ishikari City and became the Ishikari Branch.
        It is a karate club focused primarily on junior karate and parent-and-child karate.
        We especially welcome families participating together, as well as participants in the senior class.
        While many dojos are run as an extension of traditional sports clubs, our aim is to provide a fun, community-oriented environment where people can practice and learn karate as a form of health and physical education.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <BranchInfoCard
        name="Ishikari Branch"
        facts={[
          { label: "Founded", value: "March 2018 (Heisei 30)" },
          { label: "Founder", value: "Takushi Muroki" },
        ]}
        image={{
          src: "/assets/images/dojo/img_ryoku_bld.jpg",
          alt: "Ryokuentai Green Hall",
          width: 257,
          height: 182,
        }}
        address="Ryokuentai Higashi 2-jo 1-chome, Ishikari, Ryokuentai Green Hall"
        mapHref="https://www.google.com/maps/place/緑苑台グリーン会館/@43.163705,141.342457,15z/data=!4m2!3m1!1s0x0:0x2993cc986a2ad562?sa=X&ved=2ahUKEwj4zeq_1a7hAhVQQLwKHU9LDkEQ_BIwCnoECA4QCA"
        mapQuery="43.163705,141.342457"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/dojo/img_ryoku_01.jpg"
            alt="Ryokuentai Branch practice session"
            width="288"
            height="170"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_ryoku_02.jpg"
            alt="Ryokuentai Branch practice session"
            width="288"
            height="170"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_ryoku_03.jpg"
            alt="Ryokuentai Branch practice session"
            width="288"
            height="170"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/dojo/img_ryoku_04.jpg"
            alt="Ryokuentai Branch practice session"
            width="288"
            height="170"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/ebetsu/">← Back to the list of dojos & classes in Ebetsu, Iwamizawa & Ishikari</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Hanakawa-Higashi & Ryokuentai Branch"
        subject="Ryokuentai Trial Lesson Application"
      />
    </div>
  </section>
</BaseLayout>
