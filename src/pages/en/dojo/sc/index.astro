---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="ISKF Headquarters / NPO All Japan Seishinkai Office"
  description="Introducing the International Seishinryu Karate Federation (ISKF) Headquarters and the NPO All Japan Seishinkai office. Location, contact details, and office hours."
  lang="en"
  path="/en/dojo/sc/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">ISKF</span>
        <h1 class="section-title">ISKF Headquarters / NPO All Japan Seishinkai Office</h1>
      </div>

      <p class="detail-page__lead">
        [For trial lesson inquiries, please contact us at the details below]<br />
        〒003-0021<br />
        International Seishinryu Karate Federation<br />
        2-1-27 Sakaedori, Shiroishi-ku, Sapporo, c/o NPO All Japan Seishinkai Office<br />
        TEL. (+81) 011-300-0048<br />
        Phone hours are Monday-Friday, 1:00 PM-4:00 PM. Outside these hours we are in training and unable to answer the phone.<br />
        Phone duty is also handled on a rotating basis, so there may be times we cannot answer even within those hours. In that case, please use fax or email.
      </p>

      <h2 class="detail-page__heading">Members on Rotating Phone Duty</h2>
      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/clubu/nimo.jpg"
            alt="Nimo"
            width="115"
            height="148"
            loading="lazy"
          />
          <figcaption>Nimo</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/tuba2.jpg"
            alt="Tsubasa Okubo"
            width="109"
            height="145"
            loading="lazy"
          />
          <figcaption>Tsubasa Okubo</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/muroki.jpg"
            alt="Muroki"
            width="112"
            height="143"
            loading="lazy"
          />
          <figcaption>Muroki</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/takashima.jpg"
            alt="Shima"
            width="123"
            height="123"
            loading="lazy"
          />
          <figcaption>Shima</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/hashini.jpg"
            alt="Hashini"
            width="112"
            height="126"
            loading="lazy"
          />
          <figcaption>Hashini</figcaption>
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/yuko.jpg"
            alt="Wakabayashi"
            width="106"
            height="106"
            loading="lazy"
          />
          <figcaption>Wakabayashi</figcaption>
        </figure>
        <figure>
          <img
