---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";

const entries = [
  {
    marker: "★",
    name: "Kyogoku Karate Club",
    address: "160 Kyogoku, Kyogoku Town, Abuta District (Kyogoku Town Community Hall)",
    schedule: ["Tuesday 18:15/19:05"],
  },
];
---

<BaseLayout
  title="Karate Classes in Kyogoku Town"
  description="Information on the Seishinkai Karate dojo — Kyogoku Branch — in Kyogoku Town, Abuta District, Hokkaido. Training days and venue details."
  lang="en"
  path="/en/dojo/kyogoku/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate Federation — Kyogoku Branch</h1>
      </div>

      <p class="detail-page__lead">
        [Kyogoku Karate Class / Seishinkai Kyogoku Branch]<br />
        The Kyogoku Karate Club began as a branch started by members from Kyogoku Town who had been commuting
        to the Kimobetsu Branch, with the kind cooperation of Kotoku-ji Temple in Kyogoku Town.<br />
        The venue later moved to the Social Welfare Center, and since December 2019 (Reiwa 1) has been the
        large hall of the Kyogoku Town Community Hall.<br />
        The class is centered on Kids and Junior classes. Parent-child participation and Senior Class members
        are also welcome.<br />
        While many dojos feel like an extension of school sports-club activities, we aim for karate as health
        and fitness training — practicing and learning together in a relaxed, club-like atmosphere.
      </p>

      <BranchTable
        entries={entries}
        headers={["Dojo / Branch", "Address / Venue", "Training Days"]}
      />

      <p class="detail-page__note">
        ※Session 1: white belt–light blue belt, 18:15–19:00 / Session 2: blue belt and above, 19:05–20:00.
        As the venue is a rented facility, please direct inquiries to the <a
          href="mailto:karate@seishinkan.ne.jp?subject=Kyogoku Trial Lesson Application"
          >office</a
        >.
      </p>

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/kyogoku/img2.jpg"
            alt="Kyogoku Branch practice session"
            width="441"
            height="270"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/dojo/kyogoku/Image7.jpg"
            alt="Kyogoku Branch practice session"
            width="682"
            height="290"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/tuba.jpg"
            alt="Kyogoku Branch"
            width="118"
            height="118"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/images/komata.jpg"
            alt="Instructor"
            width="109"
            height="109"
            loading="lazy"
          />
        </figure>
        <figure>
          <img
            src="/assets/images/legacy/clubu/masuda.jpg"
            alt="Instructor"
            width="161"
            height="161"
            loading="lazy"
          />
        </figure>
      </div>

      <h2 class="detail-page__heading">Kyogoku Branch</h2>
      <p>
        ◆ Founded: November 2017 (Heisei 29)<br />
        ◇ Founder: Takuro Komada<br />
        ◆ In charge: Tsubasa Okubo
      </p>

      <h2 class="detail-page__heading">Venue</h2>
      <p>
        <a
          href="https://www.google.com/maps?q=%E4%BA%AC%E6%A5%B5%E7%94%BA%E5%85%AC%E6%B0%91%E9%A4%A8"
          target="_blank"
          rel="noopener">160 Kyogoku, Kyogoku Town, Abuta District, Kyogoku Town Community Hall</a
        >
      </p>
      <div class="detail-media">
        <a
          href="https://www.google.com/maps?q=%E4%BA%AC%E6%A5%B5%E7%94%BA%E5%85%AC%E6%B0%91%E9%A4%A8"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/assets/images/legacy/dojo/kyogoku/img3.jpg"
            alt="Kyogoku Town Community Hall"
            width="350"
            height="184"
            loading="lazy"
          />
        </a>
      </div>

      <p class="detail-page__note">
        ※Former venues: <a
          href="https://www.google.com/maps/place/廣徳寺/@42.8577773,140.8859652,15z/data=!4m5!3m4!1s0x0:0xbd9afdba25b2420b!8m2!3d42.8577773!4d140.8859652"
          target="_blank"
          rel="noopener">615 Aza Kyogoku, Kyogoku Town, Abuta District, Kotoku-ji Temple</a
        >
        / <a
          href="https://www.google.com/maps/place/京極町+社会福祉協議会/@42.860568,140.880615,15z/data=!4m2!3m1!1s0x0:0x444da41dc2d6035"
          target="_blank"
          rel="noopener">68 Misaki, Kyogoku Town, Abuta District, Welfare Center</a
        >
      </p>

      <div class="detail-media">
        <img
          src="/assets/images/legacy/dojo/kyogoku/Image1.jpg"
          alt="Kyogoku Branch practice session"
          width="301"
          height="145"
          loading="lazy"
        />
      </div>

      <p class="detail-page__back">
        <a href="/en/dojo/tobetsu/">← Back to the Dojo List</a>
      </p>
    </div>
  </section>
</BaseLayout>
