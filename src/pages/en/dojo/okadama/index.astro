---
import BaseLayout from "@layouts/BaseLayout.astro";
import BranchTable from "@components/BranchTable.astro";
import BranchInfoCard from "@components/BranchInfoCard.astro";
import DojoContactSection from "@components/DojoContactSection.astro";

const entries = [
  {
    marker: "★",
    name: "Okadama Karate Club",
    address:
      "Okadama Takara Children's Hall, Kita 35-jo Higashi 23-chome 7-11, Higashi-ku, Sapporo (from May 2023)",
    schedule: ["Monday 18:30"],
  },
];
---

<BaseLayout
  title="Karate Classes at the Okadama Branch, Higashi Ward"
  description="Introducing the Okadama Karate Club, a Seishinkai Karate dojo in Okadama, Higashi Ward, Sapporo. Training is held on Mondays at the Okadama Takara Children's Hall."
  lang="en"
  path="/en/dojo/okadama/"
>
  <section class="dojo-list">
    <div class="page-container">
      <div class="section__title-area">
        <span class="section-label">DOJO</span>
        <h1 class="section-title">Seishinkai Karate-do Federation — Okadama Branch</h1>
      </div>

      <h2 class="detail-page__heading">Okadama Karate Class, Seishinkai Okadama Branch, Higashi Ward</h2>

      <p class="detail-page__lead">
        The Okadama Karate Class started in March 2009 (Heisei 21) at the Okadama Takara Children's Hall.<br />
        It is a karate club centered on Kids Karate and Junior Karate.<br />
        We especially welcome participation from parents and children together, and from the Senior Class.<br />
        While many dojos feel like an extension of school sports clubs, we aim to make karate an enjoyable, club-like experience centered on health and fitness.
      </p>

      <BranchTable entries={entries} headers={["Dojo / Branch", "Address / Venue", "Training Days"]} />

      <BranchInfoCard
        name="Seishinkai Okadama Branch"
        facts={[
          { label: "Founded", value: "March 2009 (Heisei 21)" },
          { label: "Founder", value: "Kayoko Mimura" },
          { label: "Past instructors", value: "Hashini, Yuka Takigami" },
          {
            label: "Instructor",
            value: "Shima, plus adult black belt members joining occasionally",
          },
        ]}
        image={{
          src: "/assets/images/legacy/dojo/okadama/2.jpg",
          alt: "Okadama Takara Children's Hall",
          width: 272,
          height: 202,
        }}
        instructors={[
          { src: "/assets/images/instructors/shima.jpg", alt: "Instructor Shima", name: "Shima" },
          { src: "/assets/images/legacy/clubu/ooba.jpg", alt: "Instructor Ooba", name: "Ooba" },
        ]}
        address="Okadama Takara Children's Hall, Kita 35-jo Higashi 23-chome 7-10, Higashi-ku, Sapporo"
        addressNote="(from May 2023)"
        mapHref="https://www.google.com/maps/place/〒007-0835+北海道札幌市東区北３５条東２３丁目７−１０+札幌市丘珠たから児童会館/data=!4m2!3m1!1s0x5f0b2f2842249775:0x7e275989d3915e44?sa=X&ved=2ahUKEwiTiPCZqLHhAhXlFqYKHXuoByMQ8gEwAHoECAoQAQ"
        mapQuery="Okadama Takara Children's Hall, Kita 35-jo Higashi 23-chome 7-10, Higashi-ku, Sapporo"
      />

      <div class="detail-gallery">
        <figure>
          <img
            src="/assets/images/legacy/dojo/okadama/Image1.jpg"
            alt="Practice session at the Okadama Branch"
            width="272"
            height="175"
            loading="lazy"
          />
        </figure>
      </div>

      <p class="detail-page__note">
        ※Due to COVID-19, the venue moved from the Children's Hall to the Okadama-Minami Hall starting in May 2020 (Reiwa 2); however, following the relaxation of mask requirements, we returned to the previous venue, the Okadama Takara Children's Hall, in May 2023 (Reiwa 5).
      </p>

      <p class="detail-page__back">
        <a href="/en/dojo/higashi/">← Back to the Higashi Ward Dojo & Class List</a>
      </p>

      <DojoContactSection
        lang="en"
        dojoName="Okadama Branch"
        subject="Okadama Trial & Enrollment Inquiry"
      />
    </div>
  </section>
</BaseLayout>
